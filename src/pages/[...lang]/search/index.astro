---
import siteConfig from '../../../core/config/current'
import SearchBox from '../../../core/components/SearchBox'
import BaseLayout from '../../../core/components/BaseLayout.astro'
import { container } from '../../../core/config/layout'
import { useTranslations } from '../../../core/i18n'
import { themeVoice } from '../../../core/theme/current'
import { uniformAlternates } from '../../../core/seo/alternates'

export function getStaticPaths() {
  if (!siteConfig.modules.blog.enabled || siteConfig.modules.blog.search === false) return []
  return siteConfig.i18n.locales.map((locale) => ({
    params: { lang: locale === siteConfig.i18n.default ? undefined : locale },
  }))
}

const { lang: langParam } = Astro.params
const lang = langParam ?? siteConfig.i18n.default
if (
  !siteConfig.modules.blog.enabled ||
  siteConfig.modules.blog.search === false ||
  !siteConfig.i18n.locales.includes(lang) ||
  langParam === siteConfig.i18n.default
) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}
const t = useTranslations(lang)
---

<BaseLayout
  lang={lang}
  title={t('search.title')}
  alternates={uniformAlternates(siteConfig, '/search')}
>
  <div class:list={[container, 'page-top']}>
    <header data-part="page-head" class="mb-8">
      {
        themeVoice.labels === 'mono-caps' && (
          <p data-part="page-kicker" class="kicker">
            {t('search.title')}
          </p>
        )
      }
      <h1 data-part="page-title" data-part="page-title" class="page-title">
        {t('search.heading')}
      </h1>
    </header>
    <SearchBox
      client:load
      lang={lang}
      placeholder={t('search.placeholder')}
      noResults={t('search.noResults')}
    />
  </div>
</BaseLayout>
