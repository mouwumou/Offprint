---
import siteConfig from '../../../core/config/current'
import BaseLayout from '../../../core/components/BaseLayout.astro'
import PublicationRowBuiltin from '../../../core/components/PublicationRow.astro'
import { resolveWidget } from '../../../core/widgets/registry'
import { langPrefix } from '../../../core/config/nav'
import { container } from '../../../core/config/layout'
import { getProvider } from '../../../core/content'
import { moduleCopy } from '../../../core/config/copy'
import { useTranslations } from '../../../core/i18n'
import { themeVoice } from '../../../core/theme/current'
import { uniformAlternates } from '../../../core/seo/alternates'
import { scholarlyArticlesJsonLd } from '../../../core/seo/jsonld'

export function getStaticPaths() {
  if (!siteConfig.modules.publications.enabled) return []
  return siteConfig.i18n.locales.map((locale) => ({
    params: { lang: locale === siteConfig.i18n.default ? undefined : locale },
  }))
}

const { lang: langParam } = Astro.params
const lang = langParam ?? siteConfig.i18n.default
if (
  !siteConfig.modules.publications.enabled ||
  !siteConfig.i18n.locales.includes(lang) ||
  langParam === siteConfig.i18n.default
) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const t = useTranslations(lang)
const copy = moduleCopy(siteConfig, 'publications', lang)
const prefix = langPrefix(siteConfig, lang)
// publications.detail: false — plain titles, no per-publication pages.
const detail = siteConfig.modules.publications.detail !== false
const PublicationRow = resolveWidget('publication-row', PublicationRowBuiltin)
const publications = await getProvider().listPublications()
const years = [...new Set(publications.map((pub) => pub.year))].sort((a, b) => b - a)
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={uniformAlternates(siteConfig, '/publications')}
  jsonLd={scholarlyArticlesJsonLd(siteConfig, publications, lang)}
>
  <div class:list={[container, 'pb-6', 'page-top']}>
    <header data-part="page-head" class="max-w-2xl">
      {
        themeVoice.labels === 'mono-caps' && (
          <p data-part="page-kicker" class="kicker">
            {t('pub.kicker')}
          </p>
        )
      }
      <h1 data-part="page-title" data-part="page-title" data-part="page-title" class="page-title">
        {copy.title}
      </h1>
      <p data-part="page-lede" data-part="page-lede" data-part="page-lede" class="page-lede">
        {copy.description}
      </p>
    </header>

    {
      themeVoice.labels === 'plain' &&
        years.map((year) => (
          <section data-part="pub-year-group" data-year={year} class:list={['section-gap']}>
            <h2
              data-part="pub-year"
              class="border-b border-border pb-1.5 font-serif text-2xl font-semibold"
            >
              {year}
            </h2>
            <ol data-part="pub-list" class="mt-4 space-y-6">
              {publications
                .filter((pub) => pub.year === year)
                .map((pub) => (
                  <PublicationRow
                    as="li"
                    publication={pub}
                    lang={lang}
                    href={detail ? `${prefix}/publications/${pub.key}` : undefined}
                  />
                ))}
            </ol>
          </section>
        ))
    }
    {
      themeVoice.labels === 'mono-caps' &&
        years.map((year) => (
          <section
            data-part="pub-year-group"
            data-year={year}
            class="mt-12 grid gap-4 border-t border-border pt-8 md:grid-cols-[120px_1fr] md:gap-10"
          >
            <h2 data-part="pub-year" class="font-mono text-sm text-primary">
              {year}
            </h2>
            <ol data-part="pub-list" class="space-y-8">
              {publications
                .filter((pub) => pub.year === year)
                .map((pub) => (
                  <PublicationRow
                    as="li"
                    publication={pub}
                    lang={lang}
                    href={detail ? `${prefix}/publications/${pub.key}` : undefined}
                  />
                ))}
            </ol>
          </section>
        ))
    }
  </div>
</BaseLayout>
