---
import siteConfig from '../../../core/config/current'
import { contentHref } from '../../../core/content/asset-url'
import Authors from '../../../core/components/Authors.astro'
import CvTimeline, { type TimelineRow } from '../../../core/components/CvTimeline.astro'
import PublicationLinks from '../../../core/components/PublicationLinks.astro'
import SectionLabel from '../../../core/components/SectionLabel.astro'
import { container } from '../../../core/config/layout'
import { getProvider } from '../../../core/content'
import { themeVoice } from '../../../core/theme/current'
import { moduleCopy } from '../../../core/config/copy'
import { useTranslations } from '../../../core/i18n'
import { resolveLocalized, type LocalizedString } from '../../../core/schema'
import { uniformAlternates } from '../../../core/seo/alternates'
import BaseLayout from '../../../core/components/BaseLayout.astro'

export function getStaticPaths() {
  // PDF mode (modules.cv.pdf): the nav points at the file, no HTML page.
  if (!siteConfig.modules.cv.enabled || siteConfig.modules.cv.pdf !== undefined) return []
  return siteConfig.i18n.locales.map((locale) => ({
    params: { lang: locale === siteConfig.i18n.default ? undefined : locale },
  }))
}

const { lang: langParam } = Astro.params
const lang = langParam ?? siteConfig.i18n.default
if (
  !siteConfig.modules.cv.enabled ||
  siteConfig.modules.cv.pdf !== undefined ||
  !siteConfig.i18n.locales.includes(lang) ||
  langParam === siteConfig.i18n.default
) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const t = useTranslations(lang)
const copy = moduleCopy(siteConfig, 'cv', lang)
const provider = getProvider()
const cv = await provider.getCV()
if (cv === null) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const r = (value: LocalizedString | undefined) =>
  resolveLocalized(value, lang, siteConfig.i18n.default) ?? ''

const period = (entry: {
  period?: string | undefined
  startDate?: string | undefined
  endDate?: string | undefined
  date?: string | undefined
}) =>
  entry.period ??
  entry.date ??
  (entry.startDate
    ? entry.endDate === entry.startDate
      ? entry.startDate
      : `${entry.startDate} – ${entry.endDate ?? t('cv.present')}`
    : '')

const highlights = (entries: { highlights: Parameters<typeof r>[0][] }): string[] =>
  entries.highlights.map((h) => r(h)).filter((h): h is string => Boolean(h))
const appointments: TimelineRow[] = cv.work.map((entry) => ({
  period: period(entry),
  title: r(entry.position),
  org: r(entry.name),
  location: r(entry.location) || undefined,
  detail: r(entry.summary) || undefined,
  highlights: highlights(entry),
}))
const education: TimelineRow[] = cv.education.map((entry) => ({
  period: period(entry),
  title: [r(entry.studyType), r(entry.area)].filter(Boolean).join(', '),
  org: r(entry.institution),
  location: r(entry.location) || undefined,
  detail: r(entry.summary) || undefined,
}))
const awards: TimelineRow[] = cv.awards.map((entry) => ({
  period: period(entry),
  title: r(entry.title),
  org: r(entry.awarder),
  detail: r(entry.summary) || undefined,
}))
const teaching: TimelineRow[] = cv.teaching.map((entry) => ({
  period: period(entry),
  title: r(entry.position),
  org: r(entry.name),
  location: r(entry.location) || undefined,
  detail: r(entry.summary) || undefined,
  highlights: highlights(entry),
}))

const publications =
  cv.publicationsFromSite && siteConfig.modules.publications.enabled
    ? await provider.listPublications()
    : []
// JSON-Resume-style inline list; used when the CV does not pull the site's
// publications collection.
const inlinePublications = cv.publicationsFromSite ? [] : cv.publications

// content/profile.yaml is the single source; cv.yaml `basics` may override
// per field (JSON Resume compatibility, ADR-028).
const profile = await provider.getProfile()
// resolveLocalized yields '' for an absent value, so fall back on truthiness.
const name = r(cv.basics?.name) || r(profile.name)
const role = r(cv.basics?.label) || r(profile.role)
const email = cv.basics?.email ?? profile.email
const cityLine = cv.basics?.location
  ? [r(cv.basics.location.city), cv.basics.location.countryCode].filter(Boolean).join(', ')
  : ''
const location = cityLine !== '' ? cityLine : r(profile.location)
const description = `${copy.title} — ${name}`
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={description}
  noindex={siteConfig.modules.cv.indexable === false}
  alternates={siteConfig.modules.cv.indexable === false ? [] : uniformAlternates(siteConfig, '/cv')}
>
  <div class:list={[container, themeVoice.density === 'airy' ? 'pt-16 lg:pt-24' : 'pt-8 lg:pt-10']}>
    <header
      class:list={[
        'flex flex-col justify-between gap-6 sm:flex-row sm:items-end',
        themeVoice.density === 'airy' ? 'pb-10' : 'pb-6',
      ]}
    >
      <div>
        <h1
          class:list={[
            'font-serif tracking-tight',
            themeVoice.density === 'airy' ? 'text-4xl sm:text-5xl' : 'text-3xl',
          ]}
        >
          {copy.title}
        </h1>
        <p class="mt-3 font-serif text-lg text-muted-foreground">
          {[name, role].filter(Boolean).join(' · ')}
        </p>
      </div>
      <div class="flex flex-col gap-1 font-mono text-xs text-muted-foreground sm:items-end">
        {
          email && (
            <a href={`mailto:${email}`} class="text-primary hover:underline">
              {email}
            </a>
          )
        }
        {location && <span>{location}</span>}
        <button
          type="button"
          onclick="window.print()"
          class="print-hide cursor-pointer text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
        >
          {t('cv.downloadPdf')}
        </button>
      </div>
    </header>

    {
      [
        { label: t('cv.appointments'), entries: appointments },
        { label: t('cv.education'), entries: education },
      ].map(
        (section) =>
          section.entries.length > 0 && (
            <section class="grid gap-4 border-t border-border py-8 md:grid-cols-[180px_1fr] md:gap-10 md:py-10 lg:gap-12">
              <SectionLabel text={section.label} />
              <CvTimeline entries={section.entries} />
            </section>
          ),
      )
    }

    {
      inlinePublications.length > 0 && (
        <section class="grid gap-4 border-t border-border py-8 md:grid-cols-[180px_1fr] md:gap-10 md:py-10 lg:gap-12">
          <SectionLabel text={t('cv.publications')} />
          <ol class="space-y-4">
            {inlinePublications.map((pub) => (
              <li class="grid gap-1 sm:grid-cols-[140px_1fr] sm:gap-6">
                <span class="pt-0.5 font-mono text-xs text-muted-foreground">
                  {pub.releaseDate}
                </span>
                <div>
                  <h3 class="font-serif text-lg leading-snug">
                    {pub.url ? (
                      <a href={contentHref(pub.url)} class="transition-colors hover:text-primary">
                        {r(pub.name)}
                      </a>
                    ) : (
                      r(pub.name)
                    )}
                  </h3>
                  {r(pub.publisher) && (
                    <p class="text-sm text-muted-foreground italic">{r(pub.publisher)}</p>
                  )}
                  {r(pub.summary) && (
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                      {r(pub.summary)}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      publications.length > 0 && (
        <section class="grid gap-4 border-t border-border py-8 md:grid-cols-[180px_1fr] md:gap-10 md:py-10 lg:gap-12">
          <SectionLabel text={t('cv.publications')} />
          <ol class="space-y-4">
            {publications.map((pub) => (
              <li class="grid gap-1 sm:grid-cols-[140px_1fr] sm:gap-6">
                <span class="pt-0.5 font-mono text-xs text-muted-foreground">
                  {pub.year} · {pub.type}
                </span>
                <div>
                  <h3 class="font-serif text-lg leading-snug">
                    {resolveLocalized(pub.title, lang, siteConfig.i18n.default)}
                  </h3>
                  <Authors authors={pub.authors} />
                  <p class="text-sm text-muted-foreground italic">{pub.venue}</p>
                  <PublicationLinks publication={pub} lang={lang} />
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      [
        { label: t('cv.awards'), entries: awards },
        { label: t('cv.teaching'), entries: teaching },
      ].map(
        (section) =>
          section.entries.length > 0 && (
            <section class="grid gap-4 border-t border-border py-8 md:grid-cols-[180px_1fr] md:gap-10 md:py-10 lg:gap-12">
              <SectionLabel text={section.label} />
              <CvTimeline entries={section.entries} />
            </section>
          ),
      )
    }

    {
      cv.skills.length > 0 && (
        <section class="grid gap-4 border-t border-border py-8 md:grid-cols-[180px_1fr] md:gap-10 md:py-10 lg:gap-12">
          <SectionLabel text={t('cv.skills')} />
          <div class="space-y-4">
            {cv.skills.map((skill) => (
              <div class="grid gap-1 sm:grid-cols-[140px_1fr] sm:gap-6">
                <span class="pt-0.5 font-mono text-xs text-muted-foreground">{r(skill.name)}</span>
                <p class="font-serif">{skill.keywords.map((keyword) => r(keyword)).join(' · ')}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      cv.languages.length > 0 && (
        <section class="grid gap-4 border-t border-border py-8 md:grid-cols-[180px_1fr] md:gap-10 md:py-10 lg:gap-12">
          <SectionLabel text={t('cv.languages')} />
          <p class="font-serif">
            {cv.languages
              .map((entry) => [r(entry.language), r(entry.fluency)].filter(Boolean).join(' — '))
              .join(' · ')}
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>
