---
import katexCss from 'katex/dist/katex.min.css?url'
import siteConfig from '../../../core/config/current'
import { langPrefix } from '../../../core/config/nav'
import { bibliographyEntry, citationFormats, inlineCitation } from '../../../core/cite/formats'
import CiteDialog from '../../../core/components/CiteDialog'
import Comments from '../../../core/components/Comments.astro'
import { getProvider } from '../../../core/content'
import type { CitationRef } from '../../../core/content/citations'
import { renderMarkdown } from '../../../core/content/markdown'
import { formatDate, useTranslations } from '../../../core/i18n'
import { blogPostingJsonLd } from '../../../core/seo/jsonld'
import BaseLayout from '../../../core/components/BaseLayout.astro'

// Static mode: one path per published post × language; the default language
// lives at the root, others get a prefix (ADR-007). Server mode ignores this
// and resolves from params per request — the body below serves both.
export async function getStaticPaths() {
  if (!siteConfig.modules.blog) return []
  const posts = await getProvider().listPosts()
  return posts.map((post) => ({
    params: {
      lang: post.lang === siteConfig.i18n.default ? undefined : post.lang,
      urlname: post.urlname,
    },
  }))
}

const { lang: langParam, urlname = '' } = Astro.params
const lang = langParam ?? siteConfig.i18n.default

const validLang =
  siteConfig.modules.blog &&
  siteConfig.i18n.locales.includes(lang) &&
  (langParam === undefined || langParam !== siteConfig.i18n.default)
const post = validLang ? await getProvider().getPost(urlname, lang) : null

if (!post || post.draft) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const t = useTranslations(lang)

// [@key] citations resolve against publications.yaml plus any front-matter
// `references` entries shaped like publications (P3-2).
let citations: Map<string, CitationRef> | undefined
if (siteConfig.modules.publications && post.cite !== false) {
  const { publicationSchema } = await import('../../../core/schema')
  const extraRefs = Array.isArray(post.extra['references']) ? post.extra['references'] : []
  const pool = [
    ...(await getProvider().listPublications()),
    ...extraRefs.flatMap((entry) => {
      const parsed = publicationSchema.safeParse(entry)
      return parsed.success ? [parsed.data] : []
    }),
  ]
  citations = new Map(
    pool.map((pub) => [
      pub.key,
      { key: pub.key, inline: inlineCitation(pub), entry: bibliographyEntry(pub, lang) },
    ]),
  )
}

const rendered = await renderMarkdown(post.body, {
  ...(citations !== undefined
    ? {
        citations,
        citationsLabel: t('post.references'),
        cacheKey: `${lang}:${await getProvider().version()}`,
      }
    : {}),
})
const showMath = rendered.hasMath || post.math === true
const showUpdated = post.updated.getTime() !== post.date.getTime()
const kicker = post.categories[0]
const prefix = langPrefix(siteConfig, lang)

const translations = await getProvider().getTranslations(urlname)
const alternates = translations.map((translation) => ({
  lang: translation.lang,
  path: `${langPrefix(siteConfig, translation.lang)}/blog/${urlname}/`,
}))
// "Cite this post" (P3-5): a synthetic publication reuses the P3-1 formats.
import { publicationSchema as pubSchema, resolveLocalized } from '../../../core/schema'
const site = Astro.site ?? new URL('https://example.com')
const postUrl = new URL(Astro.url.pathname, site).toString()
const citePost = post.cite
  ? citationFormats(
      pubSchema.parse({
        key: post.urlname,
        title: post.title,
        authors: [resolveLocalized(siteConfig.profile.name, lang, siteConfig.i18n.default) ?? ''],
        year: post.date.getUTCFullYear(),
        venue: resolveLocalized(siteConfig.profile.name, lang, siteConfig.i18n.default) ?? 'Blog',
        type: 'preprint',
        website: postUrl,
        ...(post.doi ? { doi: post.doi } : {}),
      }),
      lang,
    )
  : null
const citeLabels = {
  cite: t('pub.cite'),
  copy: t('cite.copy'),
  copied: t('cite.copied'),
  close: t('cite.close'),
}
const jsonLd = blogPostingJsonLd(
  siteConfig,
  post,
  rendered,
  new URL(Astro.url.pathname, site).toString(),
  site.toString(),
)
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  type="article"
  image={post.cover ?? `${prefix}/blog/${post.urlname}/og.png`}
  publishedTime={post.date}
  modifiedTime={post.updated}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Fragment slot="head">{showMath && <link rel="stylesheet" href={katexCss} />}</Fragment>

  <!-- Symmetric rails keep the article dead-center in the page whether or not
       a TOC exists; the TOC lives in the right rail and sticks on scroll. -->
  <div
    class="mx-auto w-full max-w-6xl px-5 sm:px-8 lg:px-12 xl:grid xl:max-w-7xl xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-8"
  >
    <div class="hidden xl:block" aria-hidden="true"></div>
    <article class="mx-auto w-full max-w-3xl pt-14 pb-20 lg:pt-20" data-pagefind-body>
      <a
        href={`${prefix}/blog`}
        class="font-mono text-xs tracking-[0.14em] text-muted-foreground uppercase transition-colors hover:text-primary"
      >
        {t('post.back')}
      </a>

      <header class="mt-6 border-b border-border pb-8">
        {
          kicker && (
            <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">{kicker}</p>
          )
        }
        <h1 class="mt-3 font-serif text-4xl leading-[1.12] tracking-tight sm:text-[2.75rem]">
          {post.title}
        </h1>
        {
          post.description && (
            <p class="mt-4 font-serif text-xl leading-relaxed text-muted-foreground">
              {post.description}
            </p>
          )
        }
        <div
          class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-muted-foreground"
        >
          <time datetime={post.date.toISOString()}>{formatDate(post.date, lang)}</time>
          <span aria-hidden="true">·</span>
          <span>{rendered.readingTimeMinutes} {t('post.minRead')}</span>
          <span aria-hidden="true">·</span>
          <span>{rendered.wordCount.toLocaleString('en-US')} {t('post.words')}</span>
          {
            showUpdated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t('post.updated')} {formatDate(post.updated, lang)}
                </span>
              </>
            )
          }
          {
            post.doi && (
              <>
                <span aria-hidden="true">·</span>
                <a
                  href={`https://doi.org/${post.doi}`}
                  class="text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
                >
                  DOI
                </a>
              </>
            )
          }
          {
            citePost && (
              <>
                <span aria-hidden="true">·</span>
                <CiteDialog client:load formats={citePost} labels={citeLabels} />
              </>
            )
          }
        </div>
      </header>

      {
        post.cover && (
          <img
            src={post.cover}
            alt=""
            loading="lazy"
            class="mt-8 aspect-[16/9] w-full rounded-md border border-border bg-muted object-cover"
          />
        )
      }

      <div class="prose mt-10" set:html={rendered.html} />

      {
        post.tags.length > 0 && (
          <div class="mt-14 flex flex-wrap gap-2 border-t border-border pt-6">
            {post.tags.map((tag) => (
              <span class="rounded-full border border-border px-3 py-1 font-mono text-[11px] text-muted-foreground">
                #{tag}
              </span>
            ))}
          </div>
        )
      }

      <div class="mt-10 rounded-md border border-border bg-muted/40 px-5 py-4">
        <p class="font-mono text-[11px] tracking-[0.14em] text-muted-foreground uppercase">
          {t('post.colophon')}
        </p>
        <p class="mt-1.5 text-sm text-muted-foreground">{t('post.colophonText')}</p>
      </div>

      <Comments lang={lang} />
    </article>

    {
      rendered.toc.length > 0 && (
        <aside class="hidden xl:sticky xl:top-20 xl:mt-24 xl:block xl:max-h-[calc(100vh-7rem)] xl:self-start xl:overflow-y-auto">
          <nav aria-label={t('post.onThisPage')}>
            <p class="font-mono text-[11px] tracking-[0.2em] text-muted-foreground uppercase">
              {t('post.onThisPage')}
            </p>
            <ul class="mt-4 space-y-2 border-l border-border pl-4 text-sm">
              {rendered.toc.map((entry) => (
                <li class:list={[entry.depth > 2 && 'pl-3']}>
                  <a
                    href={`#${entry.id}`}
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    {entry.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>
