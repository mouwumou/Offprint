---
import { katexCss } from '../../../core/theme/katex'
import { themeVoice } from '../../../core/theme/current'
import siteConfig from '../../../core/config/current'
import { langPrefix } from '../../../core/config/nav'
import { bibliographyEntry, citationFormats, inlineCitation } from '../../../core/cite/formats'
import CiteDialog from '../../../core/components/CiteDialog'
import Comments from '../../../core/components/Comments.astro'
import { getProvider } from '../../../core/content'
import { assetUrl } from '../../../core/content/asset-url'
import type { CitationRef } from '../../../core/content/citations'
import { renderMarkdown } from '../../../core/content/markdown'
import { relatedPosts, seriesNav } from '../../../core/content/related'
import { formatDate, useTranslations } from '../../../core/i18n'
import { resolveLocalized as rl } from '../../../core/schema'
import { blogPostingJsonLd } from '../../../core/seo/jsonld'
import BaseLayout from '../../../core/components/BaseLayout.astro'

// Static mode: one path per published post × language; the default language
// lives at the root, others get a prefix (ADR-007). Server mode ignores this
// and resolves from params per request — the body below serves both.
export async function getStaticPaths() {
  if (!siteConfig.modules.blog.enabled) return []
  const posts = await getProvider().listPosts()
  return posts.map((post) => ({
    params: {
      lang: post.lang === siteConfig.i18n.default ? undefined : post.lang,
      urlname: post.urlname,
    },
  }))
}

const { lang: langParam, urlname = '' } = Astro.params
const lang = langParam ?? siteConfig.i18n.default

const validLang =
  siteConfig.modules.blog.enabled &&
  siteConfig.i18n.locales.includes(lang) &&
  (langParam === undefined || langParam !== siteConfig.i18n.default)
const post = validLang ? await getProvider().getPost(urlname, lang) : null

if (!post || post.draft) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const t = useTranslations(lang)

// [@key] citations resolve against publications.yaml plus any front-matter
// `references` entries shaped like publications (P3-2).
let citations: Map<string, CitationRef> | undefined
if (siteConfig.modules.publications.enabled && post.cite !== false) {
  const { publicationSchema } = await import('../../../core/schema')
  const extraRefs = Array.isArray(post.extra['references']) ? post.extra['references'] : []
  const pool = [
    ...(await getProvider().listPublications()),
    ...extraRefs.flatMap((entry) => {
      const parsed = publicationSchema.safeParse(entry)
      return parsed.success ? [parsed.data] : []
    }),
  ]
  citations = new Map(
    pool.map((pub) => [
      pub.key,
      { key: pub.key, inline: inlineCitation(pub), entry: bibliographyEntry(pub, lang) },
    ]),
  )
}

const allPosts = await getProvider().listPosts()
const related = siteConfig.modules.blog.related === false ? [] : relatedPosts(allPosts, post, lang)
const series = seriesNav(allPosts, post, lang)
const postHref = (entry: { urlname: string; lang: string }) =>
  `${langPrefix(siteConfig, entry.lang)}/blog/${entry.urlname}`

const rendered = await renderMarkdown(post.body, {
  ...(citations !== undefined ? { citations, citationsLabel: t('post.references') } : {}),
})
const showMath = rendered.hasMath || post.math === true
const showUpdated = post.updated.getTime() !== post.date.getTime()
const kicker = post.categories[0]
const colophonSetting = siteConfig.modules.blog.colophon
const colophonText =
  colophonSetting === false
    ? null
    : (rl(colophonSetting, lang, siteConfig.i18n.default) ?? t('post.colophonText'))
const prefix = langPrefix(siteConfig, lang)

const translations = await getProvider().getTranslations(urlname)
const alternates = translations.map((translation) => ({
  lang: translation.lang,
  path: `${langPrefix(siteConfig, translation.lang)}/blog/${urlname}/`,
}))
// "Cite this post" (P3-5): a synthetic publication reuses the P3-1 formats.
import { publicationSchema as pubSchema, resolveLocalized } from '../../../core/schema'
const site = Astro.site ?? new URL('https://example.com')
const postUrl = new URL(Astro.url.pathname, site).toString()
const citePost = post.cite
  ? citationFormats(
      pubSchema.parse({
        key: post.urlname,
        title: post.title,
        authors: [resolveLocalized(siteConfig.profile.name, lang, siteConfig.i18n.default) ?? ''],
        year: post.date.getUTCFullYear(),
        venue: resolveLocalized(siteConfig.profile.name, lang, siteConfig.i18n.default) ?? 'Blog',
        type: 'preprint',
        website: postUrl,
        ...(post.doi ? { doi: post.doi } : {}),
      }),
      lang,
    )
  : null
const citeLabels = {
  cite: t('pub.cite'),
  copy: t('cite.copy'),
  copied: t('cite.copied'),
  close: t('cite.close'),
}
const jsonLd = blogPostingJsonLd(
  siteConfig,
  post,
  rendered,
  new URL(Astro.url.pathname, site).toString(),
  site.toString(),
)
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  type="article"
  image={post.cover ? assetUrl(post.cover) : `${prefix}/blog/${post.urlname}/og.png`}
  publishedTime={post.date}
  modifiedTime={post.updated}
  alternates={alternates}
  jsonLd={jsonLd}
  canonical={post.canonical}
>
  <Fragment slot="head">{showMath && <style set:html={katexCss} />}</Fragment>

  <!-- Symmetric rails keep the article dead-center in the page whether or not
       a TOC exists; the TOC lives in the right rail and sticks on scroll. -->
  <div
    class="mx-auto w-full max-w-6xl px-5 sm:px-8 lg:px-12 xl:grid xl:max-w-7xl xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-8"
  >
    <div class="hidden xl:block" aria-hidden="true"></div>
    <article
      class:list={[
        'mx-auto w-full max-w-3xl pb-20',
        themeVoice.density === 'airy' ? 'pt-14 lg:pt-20' : 'pt-8 lg:pt-10',
      ]}
      data-pagefind-body
    >
      <a
        href={`${prefix}/blog`}
        class:list={[
          'text-muted-foreground transition-colors hover:text-primary',
          themeVoice.labels === 'mono-caps'
            ? 'font-mono text-xs tracking-[0.14em] uppercase'
            : 'text-sm',
        ]}
      >
        {t('post.back')}
      </a>

      <header
        class:list={[
          'border-b border-border',
          themeVoice.density === 'airy' ? 'mt-6 pb-8' : 'mt-4 pb-6',
        ]}
      >
        {
          kicker &&
            (themeVoice.labels === 'mono-caps' ? (
              <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">{kicker}</p>
            ) : (
              <p class="text-sm text-muted-foreground">{kicker}</p>
            ))
        }
        <h1
          class:list={[
            'font-serif leading-[1.15] tracking-tight',
            themeVoice.density === 'airy' ? 'mt-3 text-4xl sm:text-[2.75rem]' : 'mt-2 text-[2rem]',
          ]}
        >
          {post.title}
        </h1>
        {
          post.description && (
            <p
              class:list={[
                'font-serif leading-relaxed text-muted-foreground',
                themeVoice.density === 'airy' ? 'mt-4 text-xl' : 'mt-2 text-lg',
              ]}
            >
              {post.description}
            </p>
          )
        }
        <div
          class:list={[
            'mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-muted-foreground',
            themeVoice.labels === 'mono-caps' ? 'font-mono text-xs' : 'text-sm',
          ]}
        >
          <time datetime={post.date.toISOString()}>{formatDate(post.date, lang)}</time>
          <span aria-hidden="true">·</span>
          <span>{rendered.readingTimeMinutes} {t('post.minRead')}</span>
          <span aria-hidden="true">·</span>
          <span>{rendered.wordCount.toLocaleString('en-US')} {t('post.words')}</span>
          {
            showUpdated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t('post.updated')} {formatDate(post.updated, lang)}
                </span>
              </>
            )
          }
          {
            post.doi && (
              <>
                <span aria-hidden="true">·</span>
                <a
                  href={`https://doi.org/${post.doi}`}
                  class="text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
                >
                  DOI
                </a>
              </>
            )
          }
          {
            citePost && (
              <>
                <span aria-hidden="true">·</span>
                <CiteDialog
                  client:load
                  formats={citePost}
                  labels={citeLabels}
                  mono={themeVoice.labels === 'mono-caps'}
                />
              </>
            )
          }
        </div>
      </header>

      {
        post.cover && (
          <img
            src={assetUrl(post.cover)}
            alt=""
            width="1600"
            height="900"
            fetchpriority="high"
            class="mt-8 aspect-[16/9] w-full rounded-md border border-border bg-muted object-cover"
          />
        )
      }

      <div class="prose mt-10" set:html={rendered.html} />

      {
        post.tags.length > 0 && (
          <div class="mt-14 flex flex-wrap gap-2 border-t border-border pt-6">
            {post.tags.map((tag) => (
              <span class="rounded-full border border-border px-3 py-1 font-mono text-[11px] text-muted-foreground">
                #{tag}
              </span>
            ))}
          </div>
        )
      }

      {
        colophonText && (
          <div class="mt-10 rounded-md border border-border bg-muted/40 px-5 py-4">
            <p
              class:list={[
                'text-muted-foreground',
                themeVoice.labels === 'mono-caps'
                  ? 'font-mono text-[11px] tracking-[0.14em] uppercase'
                  : 'text-xs font-semibold',
              ]}
            >
              {t('post.colophon')}
            </p>
            <p class="mt-1.5 text-sm text-muted-foreground">{colophonText}</p>
          </div>
        )
      }

      {
        series.length > 0 && (
          <nav
            aria-label={t('post.series')}
            class="mt-10 rounded-md border border-border px-5 py-4"
          >
            <p
              class:list={[
                'text-muted-foreground',
                themeVoice.labels === 'mono-caps'
                  ? 'font-mono text-[11px] tracking-[0.14em] uppercase'
                  : 'text-xs font-semibold',
              ]}
            >
              {t('post.series')} · {post.series}
            </p>
            <ol class="mt-3 space-y-1.5">
              {series.map((entry, index) => (
                <li class="flex items-baseline gap-3">
                  <span
                    class:list={[
                      'text-muted-foreground',
                      themeVoice.labels === 'mono-caps' ? 'font-mono text-xs' : 'text-sm',
                    ]}
                  >
                    {index + 1}
                  </span>
                  {entry.urlname === post.urlname ? (
                    <span class="font-serif font-semibold">{entry.title}</span>
                  ) : (
                    <a
                      href={postHref(entry)}
                      class="font-serif transition-colors hover:text-primary"
                    >
                      {entry.title}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="mt-14 border-t border-border pt-8">
            <h2
              class:list={[
                'text-muted-foreground',
                themeVoice.labels === 'mono-caps'
                  ? 'font-mono text-xs tracking-[0.2em] uppercase'
                  : 'text-sm font-semibold',
              ]}
            >
              {t('post.related')}
            </h2>
            <div class="mt-4 divide-y divide-border">
              {related.map((entry) => (
                <a href={postHref(entry)} class="group block py-4 first:pt-0">
                  <div class="flex items-baseline gap-3">
                    <time
                      datetime={entry.date.toISOString()}
                      class="font-mono text-xs text-muted-foreground"
                    >
                      {formatDate(entry.date, lang)}
                    </time>
                    {entry.lang !== lang && (
                      <span class="rounded-sm border border-border px-1.5 font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase">
                        {entry.lang}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-1 font-serif text-lg leading-snug transition-colors group-hover:text-primary">
                    {entry.title}
                  </h3>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <Comments lang={lang} />
    </article>

    {
      rendered.toc.length > 0 && (
        <aside
          class:list={[
            'hidden xl:sticky xl:top-20 xl:block xl:max-h-[calc(100vh-7rem)] xl:self-start xl:overflow-y-auto',
            themeVoice.density === 'airy' ? 'xl:mt-24' : 'xl:mt-12',
          ]}
        >
          <nav aria-label={t('post.onThisPage')}>
            <p
              class:list={[
                'text-muted-foreground',
                themeVoice.labels === 'mono-caps'
                  ? 'font-mono text-[11px] tracking-[0.2em] uppercase'
                  : 'text-xs font-semibold',
              ]}
            >
              {t('post.onThisPage')}
            </p>
            <ul class="mt-4 space-y-2 border-l border-border pl-4 text-sm">
              {rendered.toc.map((entry) => (
                <li class:list={[entry.depth > 2 && 'pl-3']}>
                  <a
                    href={`#${entry.id}`}
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    {entry.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>
