---
import siteConfig from '../config/current'
import type { Page } from '../content'
import { getProvider } from '../content'
import { renderMarkdown, type RenderedMarkdown } from '../content/markdown'
import { postsForLanguage } from '../content/posts-view'
import { useTranslations, type MessageKey } from '../i18n'
import { resolveLocalized, type LocalizedString } from '../schema'
import { uniformAlternates } from '../seo/alternates'
import { personJsonLd, scholarlyArticlesJsonLd } from '../seo/jsonld'
import { katexCss } from '../theme/katex'
import BaseLayout from './BaseLayout.astro'
import About from './home/About.astro'
import Hero from './home/Hero.astro'
import Projects from './home/Projects.astro'
import Prose from './home/Prose.astro'
import RecentPosts from './home/RecentPosts.astro'
import SelectedPublications from './home/SelectedPublications.astro'

interface Props {
  lang: string
}

const { lang } = Astro.props
const t = useTranslations(lang)
const fallback = siteConfig.i18n.default
const profile = siteConfig.profile
const provider = getProvider()
const modules = siteConfig.modules
const sections = siteConfig.home.sections

const name = resolveLocalized(profile.name, lang, fallback)

// Data is fetched once per section kind actually present in the sequence;
// sections whose module is off or whose data is empty are skipped at render.
const wantsPubs =
  modules.publications.enabled && sections.some((s) => s.type === 'selected-publications')
const publications = wantsPubs ? await provider.listPublications() : []
const selected = publications.filter((pub) => pub.selected)
const rest = publications.filter((pub) => !pub.selected)

const wantsPosts = modules.blog.enabled && sections.some((s) => s.type === 'recent-posts')
const posts = wantsPosts ? postsForLanguage(await provider.listPosts(), lang) : []

const wantsProjects = modules.projects.enabled && sections.some((s) => s.type === 'projects')
const projects = wantsProjects ? await provider.listProjects() : []

// Prose sections resolve their page in the requested language, falling back
// to the default language.
const prose = new Map<number, { page: Page; rendered: RenderedMarkdown }>()
if (modules.pages.enabled) {
  for (const [index, section] of sections.entries()) {
    if (section.type !== 'prose') continue
    const page =
      (await provider.getPage(section.page, lang)) ??
      (await provider.getPage(section.page, fallback))
    if (page === null) continue
    prose.set(index, { page, rendered: await renderMarkdown(page.body) })
  }
}
const hasMath = [...prose.values()].some((entry) => entry.rendered.hasMath)

const sectionTitle = (title: LocalizedString | undefined, key: MessageKey): string =>
  resolveLocalized(title, lang, fallback) ?? t(key)
---

<BaseLayout
  lang={lang}
  title={name ?? 'Offprint'}
  description={resolveLocalized(profile.tagline, lang, fallback)}
  image={profile.photo}
  alternates={uniformAlternates(siteConfig, '/')}
  jsonLd={[
    personJsonLd(siteConfig, lang, (Astro.site ?? new URL('https://example.com')).toString()),
    ...scholarlyArticlesJsonLd(siteConfig, selected, lang),
  ]}
>
  <Fragment slot="head">{hasMath && <style set:html={katexCss} />}</Fragment>

  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8 lg:px-12">
    {
      sections.map((section, index) => {
        if (section.type === 'hero') return <Hero lang={lang} />
        if (section.type === 'about')
          return (
            profile.bio.length > 0 && (
              <About lang={lang} title={sectionTitle(section.title, 'home.about')} />
            )
          )
        if (section.type === 'selected-publications')
          return (
            publications.length > 0 && (
              <SelectedPublications
                lang={lang}
                title={sectionTitle(section.title, 'home.selectedWork')}
                selected={selected}
                rest={section.others ? rest : []}
              />
            )
          )
        if (section.type === 'recent-posts')
          return (
            posts.length > 0 && (
              <RecentPosts
                lang={lang}
                title={sectionTitle(section.title, 'home.recentWriting')}
                posts={posts.slice(0, section.count)}
              />
            )
          )
        if (section.type === 'projects')
          return (
            projects.length > 0 && (
              <Projects
                lang={lang}
                title={sectionTitle(section.title, 'home.projects')}
                projects={section.count === undefined ? projects : projects.slice(0, section.count)}
              />
            )
          )
        const entry = prose.get(index)
        return (
          entry !== undefined && (
            <Prose
              title={
                section.title === false
                  ? null
                  : (resolveLocalized(section.title, lang, fallback) ?? entry.page.title)
              }
              rendered={entry.rendered}
            />
          )
        )
      })
    }
  </div>
</BaseLayout>
