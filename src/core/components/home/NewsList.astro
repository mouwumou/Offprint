---
import type { NewsItem } from '../../content'
import { formatDate } from '../../i18n'
import siteConfig from '../../config/current'
import { contentHref } from '../../content/asset-url'
import { resolveLocalized } from '../../schema'
import PlainSection from './PlainSection.astro'

interface Props {
  lang: string
  title: string
  items: NewsItem[]
}

const { lang, title, items } = Astro.props
const r = (value: Parameters<typeof resolveLocalized>[0]) =>
  resolveLocalized(value, lang, siteConfig.i18n.default)
---

<PlainSection part="news" title={title}>
  <ul data-part="news-list" class="space-y-2">
    {
      items.map((item) => (
        <li data-part="news-item" class="flex gap-4 font-serif text-[15px] leading-relaxed">
          <time
            datetime={item.date.toISOString()}
            class="shrink-0 basis-36 text-muted-foreground tabular-nums"
          >
            {formatDate(item.date, lang)}
          </time>
          <span>
            {item.href ? (
              <a href={contentHref(item.href)} class="text-primary hover:underline">
                {r(item.text)}
              </a>
            ) : (
              r(item.text)
            )}
          </span>
        </li>
      ))
    }
  </ul>
</PlainSection>
