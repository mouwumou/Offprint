---
import siteConfig from '../../config/current'
import { langPrefix } from '../../config/nav'
import { useTranslations } from '../../i18n'
import { resolveLocalized } from '../../schema'

interface Props {
  lang: string
}

const { lang } = Astro.props
const t = useTranslations(lang)
const prefix = langPrefix(siteConfig, lang)
const profile = siteConfig.profile
const r = (value: Parameters<typeof resolveLocalized>[0]) =>
  resolveLocalized(value, lang, siteConfig.i18n.default)

const name = r(profile.name)
const links = profile.links.map((link) => ({ href: link.href, label: r(link.label) }))
---

<section class="pt-16 pb-12 lg:pt-24">
  <div class="grid gap-8 sm:grid-cols-[220px_1fr] sm:items-center sm:gap-12">
    {
      profile.photo && (
        <figure class="group relative max-w-[220px]">
          <img
            src={profile.photo}
            alt={name}
            class="aspect-[4/5] w-full rounded-md border border-border bg-muted object-cover grayscale transition-all duration-500 group-hover:grayscale-0"
          />
        </figure>
      )
    }
    <div>
      {
        profile.role && (
          <p class="font-mono text-xs tracking-[0.2em] text-primary uppercase">{r(profile.role)}</p>
        )
      }
      <h1 class="mt-3 font-serif text-4xl leading-[1.06] tracking-tight sm:text-5xl">{name}</h1>
      {
        profile.field && (
          <p class="mt-3 font-serif text-xl text-muted-foreground">{r(profile.field)}</p>
        )
      }
      {
        profile.tagline && (
          <p class="mt-5 max-w-xl font-serif text-lg leading-relaxed">{r(profile.tagline)}</p>
        )
      }
      <div class="mt-7 flex flex-wrap gap-3">
        {
          siteConfig.modules.blog.enabled && (
            <a
              href={`${prefix}/blog`}
              class="rounded-md bg-primary px-4 py-2 font-mono text-xs tracking-[0.12em] text-primary-foreground uppercase transition-opacity hover:opacity-90"
            >
              {t('home.readWriting')}
            </a>
          )
        }
        {
          siteConfig.modules.cv.enabled && (
            <a
              href={`${prefix}/cv`}
              class="rounded-md border border-border px-4 py-2 font-mono text-xs tracking-[0.12em] text-foreground uppercase transition-colors hover:bg-secondary"
            >
              {t('home.viewCV')}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Meta strip -->
  <dl class="mt-12 grid gap-6 border-t border-border pt-6 sm:grid-cols-3 sm:gap-8">
    <div>
      <dt class="font-mono text-[11px] tracking-[0.18em] text-muted-foreground uppercase">
        {t('home.affiliation')}
      </dt>
      <dd class="mt-1.5 font-serif leading-snug">{r(profile.affiliation)}</dd>
      <dd class="text-sm text-muted-foreground">{r(profile.location)}</dd>
    </div>
    <div>
      <dt class="font-mono text-[11px] tracking-[0.18em] text-muted-foreground uppercase">
        {t('home.contact')}
      </dt>
      <dd class="mt-1.5">
        <a
          href={`mailto:${profile.email}`}
          class="font-serif text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
        >
          {profile.email}
        </a>
      </dd>
    </div>
    <div>
      <dt class="font-mono text-[11px] tracking-[0.18em] text-muted-foreground uppercase">
        {t('home.elsewhere')}
      </dt>
      <dd class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs text-muted-foreground transition-colors hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </dd>
    </div>
  </dl>
</section>
