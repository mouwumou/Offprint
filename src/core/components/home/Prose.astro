---
import type { RenderedMarkdown } from '../../content/markdown'
import SectionShell from './SectionShell.astro'

// A standalone page's markdown rendered inline as a homepage section
//. `title: false` in the section config drops the label column.
interface Props {
  title: string | null
  rendered: RenderedMarkdown
}

const { title, rendered } = Astro.props
---

{
  title !== null ? (
    <SectionShell part="prose" label={title}>
      <div class="prose max-w-2xl" set:html={rendered.html} />
    </SectionShell>
  ) : (
    <section data-part="section" data-section="prose" class="border-t border-border py-12 md:py-14">
      <div class="prose max-w-2xl" set:html={rendered.html} />
    </section>
  )
}
