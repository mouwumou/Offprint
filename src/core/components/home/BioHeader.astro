---
import siteConfig from '../../config/current'
import { getProvider } from '../../content'
import { contentHref } from '../../content/asset-url'
import { cvHref } from '../../config/nav'
import { useTranslations } from '../../i18n'
import { resolveLocalized } from '../../schema'

// Compact academic header (A2, from the approved layout prototype): the name
// as an ordinary heading, a small photo on the right (its own proportions,
// see .profile-photo in base.css), bio paragraphs,
// then one row of quick links — substance in the first viewport, no stage.
interface Props {
  lang: string
}

const { lang } = Astro.props
const t = useTranslations(lang)
const profile = await getProvider().getProfile()
const r = (value: Parameters<typeof resolveLocalized>[0]) =>
  resolveLocalized(value, lang, siteConfig.i18n.default)

const name = r(profile.name)
const subtitle = [r(profile.role), r(profile.location)].filter(Boolean).join(' · ')
const tagline = r(profile.tagline)
const bio = profile.bio.map((paragraph) => r(paragraph))

const quicklinks: { label: string; href: string; external: boolean }[] = []
if (profile.email) {
  quicklinks.push({ label: t('bio.email'), href: `mailto:${profile.email}`, external: false })
}
if (siteConfig.modules['cv']?.enabled) {
  quicklinks.push({ label: t('nav.cv'), href: cvHref(siteConfig, lang), external: false })
}
for (const link of profile.links) {
  quicklinks.push({
    label: r(link.label) ?? link.href,
    href: contentHref(link.href),
    external: true,
  })
}
---

<header data-part="bio-header" class="pt-8 sm:pt-12">
  <div class="flex items-start gap-6 sm:gap-8">
    <div class="min-w-0 flex-1">
      <div class="flex items-center justify-between gap-4">
        <h1 data-part="bio-name" class="font-serif text-3xl tracking-tight">{name}</h1>
        {
          profile.photo && (
            <span class="photo-frame w-24 shrink-0 sm:hidden">
              <img
                src={profile.photo}
                alt={name}
                class="profile-photo rounded-md border border-border"
              />
            </span>
          )
        }
      </div>
      {
        subtitle && (
          <p data-part="bio-subtitle" class="mt-1 text-sm text-muted-foreground">
            {subtitle}
          </p>
        )
      }
      {
        tagline && (
          <p data-part="bio-tagline" class="mt-4 font-serif text-lg leading-snug">
            {tagline}
          </p>
        )
      }
      <div data-part="bio-text" class="mt-4 space-y-3">
        {bio.map((paragraph) => <p class="font-serif leading-relaxed">{paragraph}</p>)}
      </div>
    </div>
    {
      profile.photo && (
        <span data-part="bio-photo-frame" class="photo-frame hidden w-40 shrink-0 sm:block sm:w-44">
          <img
            src={profile.photo}
            alt={name}
            data-part="bio-photo"
            class="profile-photo rounded-md border border-border"
          />
        </span>
      )
    }
  </div>
  <p data-part="bio-links" class="mt-4 font-serif text-[15px]">
    {
      quicklinks.map((link, index) => (
        <>
          {index > 0 && <span class="text-muted-foreground"> · </span>}
          <a
            href={link.href}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="text-primary hover:underline"
          >
            {link.label}
          </a>
        </>
      ))
    }
  </p>
</header>
