---
import { katexCss } from '../theme/katex'
import type { Page } from '../content'
import type { RenderedMarkdown } from '../content/markdown'
import { plainText } from '../content/text'
import { formatDate, useTranslations } from '../i18n'
import type { Alternate } from '../seo/alternates'
import BaseLayout from './BaseLayout.astro'

interface Props {
  lang: string
  page: Page
  rendered: RenderedMarkdown
  alternates: Alternate[]
}

const { lang, page, rendered, alternates } = Astro.props
const t = useTranslations(lang)
// SEO: every page carries a meta description (academic SEO) — front matter
// first, else the opening of the body.
const description = page.description ?? plainText(page.body).slice(0, 160)
---

<BaseLayout lang={lang} title={page.title} description={description} alternates={alternates}>
  <Fragment slot="head">{rendered.hasMath && <style set:html={katexCss} />}</Fragment>

  <article
    data-part="page"
    class="article-top mx-auto w-full max-w-3xl px-5 pb-20 sm:px-8"
    data-pagefind-body
  >
    <header data-part="page-head" class="article-head">
      <h1 data-part="page-title" class="article-title">
        {page.title}
      </h1>
      {
        page.updated && (
          <p class="mt-4 font-mono text-xs text-muted-foreground">
            {t('post.updated')} {formatDate(page.updated, lang)}
          </p>
        )
      }
    </header>
    <div data-part="page-body" class="prose mt-10" set:html={rendered.html} />
  </article>
</BaseLayout>
