---
import { formatDate, useTranslations } from '../i18n'
import type { PostSummary } from '../content/provider'
import { themeVoice } from '../theme/current'

// One post entry — the built-in behind the `post-row` widget. `full` is the
// blog index row (date column, reading time, category, description, tags);
// `compact` is the home "recent-posts" row. Both follow the theme's voice.
interface Props {
  post: PostSummary
  lang: string
  href: string
  variant: 'full' | 'compact'
  /** Reading time, shown by the full variant. */
  minutes?: number | undefined
}

const { post, lang, href, variant, minutes } = Astro.props
const t = useTranslations(lang)
const mono = themeVoice.labels === 'mono-caps'
const foreign = post.lang !== lang
---

{
  variant === 'full' ? (
    <article data-part="post-row" data-urlname={post.urlname}>
      <a href={href} class:list={['group grid gap-4 sm:grid-cols-[130px_1fr]', 'post-row-pad']}>
        <div
          data-part="post-meta"
          class="flex flex-row items-baseline gap-3 sm:flex-col sm:gap-1 sm:pt-1"
        >
          <time
            datetime={post.date.toISOString()}
            class:list={['text-muted-foreground', mono ? 'font-mono text-xs' : 'text-sm']}
          >
            {formatDate(post.date, lang)}
          </time>
          {minutes !== undefined && (
            <span
              class:list={['text-muted-foreground', mono ? 'font-mono text-[11px]' : 'text-xs']}
            >
              {minutes} {t('blog.min')}
            </span>
          )}
        </div>
        <div>
          <span class="flex flex-wrap items-baseline gap-2">
            {post.categories[0] && (
              <span
                data-part="post-category"
                class:list={[
                  mono
                    ? 'font-mono text-[11px] tracking-[0.14em] text-primary uppercase'
                    : 'text-sm text-muted-foreground',
                ]}
              >
                {post.categories[0]}
              </span>
            )}
            {foreign && (
              <span
                data-part="post-lang"
                class="rounded-sm border border-border px-1.5 font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase"
              >
                {post.lang}
              </span>
            )}
          </span>
          <h2
            data-part="post-title"
            class="mt-1 font-serif text-2xl leading-snug transition-colors group-hover:text-primary"
          >
            {post.top && (
              <span
                class="mr-2 align-middle font-mono text-xs text-primary"
                title={t('blog.pinned')}
              >
                ★
              </span>
            )}
            {post.title}
          </h2>
          {post.description && (
            <p
              data-part="post-description"
              class="mt-2 max-w-2xl leading-relaxed text-muted-foreground"
            >
              {post.description}
            </p>
          )}
          {post.tags.length > 0 && (
            <div data-part="post-tags" class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
              {post.tags.map((tag) => (
                <span
                  class:list={['text-muted-foreground', mono ? 'font-mono text-[11px]' : 'text-xs']}
                >
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </a>
    </article>
  ) : mono ? (
    <a
      href={href}
      data-part="post-row"
      data-urlname={post.urlname}
      class="group block py-5 first:pt-0"
    >
      <div data-part="post-meta" class="flex items-baseline gap-3">
        <time datetime={post.date.toISOString()} class="font-mono text-xs text-muted-foreground">
          {formatDate(post.date, lang)}
        </time>
        {post.categories[0] && (
          <span
            data-part="post-category"
            class="font-mono text-[11px] tracking-[0.14em] text-primary uppercase"
          >
            {post.categories[0]}
          </span>
        )}
        {foreign && (
          <span
            data-part="post-lang"
            class="rounded-sm border border-border px-1.5 font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase"
          >
            {post.lang}
          </span>
        )}
      </div>
      <h3
        data-part="post-title"
        class="mt-1.5 font-serif text-xl leading-snug transition-colors group-hover:text-primary"
      >
        {post.title}
      </h3>
      {post.description && (
        <p data-part="post-description" class="mt-1 max-w-2xl text-muted-foreground">
          {post.description}
        </p>
      )}
    </a>
  ) : (
    <a
      href={href}
      data-part="post-row"
      data-urlname={post.urlname}
      class="group block py-4 first:pt-0"
    >
      <div data-part="post-meta" class="flex items-baseline gap-3">
        <time datetime={post.date.toISOString()} class="text-sm text-muted-foreground">
          {formatDate(post.date, lang)}
        </time>
        {foreign && (
          <span
            data-part="post-lang"
            class="rounded-sm border border-border px-1.5 text-xs text-muted-foreground"
          >
            {post.lang}
          </span>
        )}
      </div>
      <span
        data-part="post-title"
        class="mt-0.5 block font-serif text-[17px] leading-snug text-primary group-hover:underline"
      >
        {post.title}
      </span>
      {post.description && (
        <p data-part="post-description" class="mt-0.5 max-w-2xl text-sm text-muted-foreground">
          {post.description}
        </p>
      )}
    </a>
  )
}
