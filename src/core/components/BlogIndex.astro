---
import config from '../config/current'
import { container } from '../config/layout'
import { langPrefix } from '../config/nav'
import { getProvider } from '../content'
import { filterSlug } from '../content/filter-slug'
import { markdownStats } from '../content/markdown'
import { postsForLanguage, tagsForLanguage } from '../content/posts-view'
import { recentlyUpdated } from '../content/related'
import { moduleCopy } from '../config/copy'
import { formatDate, useTranslations } from '../i18n'
import { themeVoice } from '../theme/current'

interface Props {
  lang: string
  activeTag?: string | undefined
  activeCategory?: string | undefined
}

const { lang, activeTag, activeCategory } = Astro.props
const t = useTranslations(lang)
const prefix = langPrefix(config, lang)
const provider = getProvider()

const all = postsForLanguage(await provider.listPosts(), lang)
const posts = all
  .filter((post) => (activeTag === undefined ? true : post.tags.includes(activeTag)))
  .filter((post) =>
    activeCategory === undefined ? true : post.categories.includes(activeCategory),
  )
const tags = tagsForLanguage(await provider.listPosts(), lang)

const rows = await Promise.all(
  posts.map(async (post) => {
    const full = await provider.getPost(post.urlname, post.lang)
    return { post, minutes: full ? markdownStats(full.body).readingTimeMinutes : 1 }
  }),
)

const postHref = (post: { urlname: string; lang: string }) =>
  `${langPrefix(config, post.lang)}/blog/${post.urlname}`

const copy = moduleCopy(config, 'blog', lang)
const intro = `${copy.description ?? ''} ${all.length} ${t('blog.postsCount')}`
const updatedPosts =
  activeTag === undefined && activeCategory === undefined
    ? recentlyUpdated(await provider.listPosts(), lang)
    : []
---

<div
  class:list={[
    container,
    'pb-6',
    themeVoice.density === 'airy' ? 'pt-16 lg:pt-24' : 'pt-8 lg:pt-10',
  ]}
>
  <header class="max-w-2xl">
    {
      themeVoice.labels === 'mono-caps' && (
        <p class="font-mono text-xs tracking-[0.2em] text-primary uppercase">{t('blog.kicker')}</p>
      )
    }
    <h1
      class:list={[
        'font-serif tracking-tight',
        themeVoice.density === 'airy' ? 'mt-4 text-4xl sm:text-5xl' : 'text-3xl',
      ]}
    >
      {copy.title}
    </h1>
    <p
      class:list={[
        'font-serif leading-relaxed text-muted-foreground',
        themeVoice.density === 'airy' ? 'mt-4 text-lg' : 'mt-2 text-base',
      ]}
    >
      {intro}
    </p>
  </header>

  <!-- Tag filter: state carried by the URL path, no client state -->
  <nav
    aria-label={t('blog.filter')}
    class:list={[
      'flex flex-wrap items-center gap-2 border-y border-border py-4',
      themeVoice.density === 'airy' ? 'mt-10' : 'mt-6',
    ]}
  >
    <span
      class:list={[
        'mr-1 text-muted-foreground',
        themeVoice.labels === 'mono-caps'
          ? 'font-mono text-[11px] tracking-[0.14em] uppercase'
          : 'text-xs font-semibold',
      ]}
    >
      {t('blog.filter')}
    </span>
    <a
      href={`${prefix}/blog`}
      class:list={[
        'rounded-full px-3 py-1 font-mono text-xs tracking-wide transition-colors',
        activeTag === undefined && activeCategory === undefined
          ? 'bg-primary text-primary-foreground'
          : 'border border-border text-muted-foreground hover:text-foreground',
      ]}
    >
      {t('blog.all')}
    </a>
    {
      tags.map(({ tag, count }) => (
        <a
          href={`${prefix}/blog/tag/${encodeURIComponent(filterSlug(tag))}`}
          class:list={[
            'rounded-full px-3 py-1 font-mono text-xs tracking-wide transition-colors',
            activeTag === tag
              ? 'bg-primary text-primary-foreground'
              : 'border border-border text-muted-foreground hover:text-foreground',
          ]}
        >
          {tag}
          <span class="ml-1.5 opacity-60">{count}</span>
        </a>
      ))
    }
  </nav>

  {
    updatedPosts.length > 0 && (
      <aside class="mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span
          class:list={[
            'text-muted-foreground',
            themeVoice.labels === 'mono-caps'
              ? 'font-mono text-[11px] tracking-[0.14em] uppercase'
              : 'text-xs font-semibold',
          ]}
        >
          {t('blog.recentlyUpdated')}
        </span>
        {updatedPosts.map((entry) => (
          <a
            href={postHref(entry)}
            class="font-serif text-sm text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary"
          >
            {entry.title}
          </a>
        ))}
      </aside>
    )
  }

  <div class="mt-4 divide-y divide-border">
    {
      rows.map(({ post, minutes }) => (
        <article>
          <a
            href={postHref(post)}
            class:list={[
              'group grid gap-4 sm:grid-cols-[130px_1fr]',
              themeVoice.density === 'airy' ? 'py-8' : 'py-5',
            ]}
          >
            <div class="flex flex-row items-baseline gap-3 sm:flex-col sm:gap-1 sm:pt-1">
              <time
                datetime={post.date.toISOString()}
                class:list={[
                  'text-muted-foreground',
                  themeVoice.labels === 'mono-caps' ? 'font-mono text-xs' : 'text-sm',
                ]}
              >
                {formatDate(post.date, lang)}
              </time>
              <span
                class:list={[
                  'text-muted-foreground',
                  themeVoice.labels === 'mono-caps' ? 'font-mono text-[11px]' : 'text-xs',
                ]}
              >
                {minutes} {t('blog.min')}
              </span>
            </div>
            <div>
              <span class="flex flex-wrap items-baseline gap-2">
                {post.categories[0] && (
                  <span
                    class:list={[
                      themeVoice.labels === 'mono-caps'
                        ? 'font-mono text-[11px] tracking-[0.14em] text-primary uppercase'
                        : 'text-sm text-muted-foreground',
                    ]}
                  >
                    {post.categories[0]}
                  </span>
                )}
                {post.lang !== lang && (
                  <span class="rounded-sm border border-border px-1.5 font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase">
                    {post.lang}
                  </span>
                )}
              </span>
              <h2 class="mt-1 font-serif text-2xl leading-snug transition-colors group-hover:text-primary">
                {post.top && (
                  <span
                    class="mr-2 align-middle font-mono text-xs text-primary"
                    title={t('blog.pinned')}
                  >
                    ★
                  </span>
                )}
                {post.title}
              </h2>
              {post.description && (
                <p class="mt-2 max-w-2xl leading-relaxed text-muted-foreground">
                  {post.description}
                </p>
              )}
              {post.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
                  {post.tags.map((tag) => (
                    <span
                      class:list={[
                        'text-muted-foreground',
                        themeVoice.labels === 'mono-caps' ? 'font-mono text-[11px]' : 'text-xs',
                      ]}
                    >
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </article>
      ))
    }
    {
      rows.length === 0 && (
        <p class="py-16 text-center font-serif text-muted-foreground">
          {t('blog.noPostsTagged').replace('{tag}', activeTag ?? activeCategory ?? '')}
        </p>
      )
    }
  </div>
</div>
