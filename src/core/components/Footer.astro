---
import config from '../config/current'
import { container } from '../config/layout'
import { langPrefix } from '../config/nav'
import { getProvider } from '../content'
import { contentHref } from '../content/asset-url'
import { useTranslations } from '../i18n'
import { resolveLocalized } from '../schema'

interface Props {
  lang: string
}

const { lang } = Astro.props
const t = useTranslations(lang)
const prefix = langPrefix(config, lang)
const profile = await getProvider().getProfile()
const name = resolveLocalized(profile.name, lang, config.i18n.default)
const affiliation = resolveLocalized(profile.affiliation, lang, config.i18n.default)
const links = profile.links.map((link) => ({
  href: contentHref(link.href),
  label: resolveLocalized(link.label, lang, config.i18n.default),
}))
const year = new Date().getFullYear()
// No default credit line — the template never signs the author's
// site. A colophon appears only when site.yaml provides one.
const colophon =
  config.footer.colophon === false
    ? null
    : (resolveLocalized(config.footer.colophon, lang, config.i18n.default) ?? null)
// With neither an affiliation nor a colophon the two-block footer is mostly
// air: collapse to one baseline-aligned row (name | links · © year).
const oneLine = !affiliation && colophon === null
---

{
  config.footer.enabled && (
    <footer
      data-part="site-footer"
      class:list={['site-footer border-t border-border', oneLine ? 'mt-12' : 'site-footer--stack']}
    >
      <div
        class:list={[
          container,
          oneLine
            ? 'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-5'
            : 'flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between',
          !oneLine && 'site-footer__body',
        ]}
      >
        <div>
          <p data-part="footer-name" class:list={['font-serif', oneLine ? 'text-sm' : 'text-base']}>
            {name}
          </p>
          {affiliation && (
            <p data-part="footer-affiliation" class="mt-1 max-w-sm text-sm text-muted-foreground">
              {affiliation}
            </p>
          )}
        </div>
        <div
          class:list={
            oneLine
              ? 'flex flex-wrap items-baseline gap-x-4 gap-y-1'
              : 'flex flex-col gap-2 sm:items-end'
          }
        >
          <div data-part="footer-links" class="flex flex-wrap gap-x-4 gap-y-1">
            {links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'text-muted-foreground transition-colors hover:text-primary',
                  'ui-label',
                ]}
              >
                {link.label}
              </a>
            ))}
            {config.footer.rss && config.modules.blog.enabled && (
              <a
                href={`${prefix}/rss.xml`}
                class:list={[
                  'text-muted-foreground transition-colors hover:text-primary',
                  'ui-label',
                ]}
              >
                {t('layout.rss')}
              </a>
            )}
          </div>
          <p data-part="footer-colophon" class:list={['text-muted-foreground', 'ui-caption']}>
            {colophon !== null && <>{colophon} · </>}© {year}
          </p>
        </div>
      </div>
    </footer>
  )
}
