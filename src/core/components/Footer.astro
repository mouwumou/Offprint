---
import config from '../config/current'
import { container } from '../config/layout'
import { langPrefix } from '../config/nav'
import { contentHref } from '../content/asset-url'
import { useTranslations } from '../i18n'
import { resolveLocalized } from '../schema'
import { themeVoice } from '../theme/current'

interface Props {
  lang: string
}

const { lang } = Astro.props
const t = useTranslations(lang)
const prefix = langPrefix(config, lang)
const name = resolveLocalized(config.profile.name, lang, config.i18n.default)
const affiliation = resolveLocalized(config.profile.affiliation, lang, config.i18n.default)
const links = config.profile.links.map((link) => ({
  href: contentHref(link.href),
  label: resolveLocalized(link.label, lang, config.i18n.default),
}))
const year = new Date().getFullYear()
// ADR-027: no default credit line — the template never signs the author's
// site. A colophon appears only when site.yaml provides one.
const colophon =
  config.footer.colophon === false
    ? null
    : (resolveLocalized(config.footer.colophon, lang, config.i18n.default) ?? null)
---

{
  config.footer.enabled && (
    <footer
      class:list={[
        'site-footer border-t border-border',
        themeVoice.density === 'airy' ? 'mt-24' : 'mt-14',
      ]}
    >
      <div
        class:list={[
          container,
          'flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between',
          themeVoice.density === 'airy' ? 'py-10' : 'py-7',
        ]}
      >
        <div>
          <p class="font-serif text-base">{name}</p>
          {affiliation && <p class="mt-1 max-w-sm text-sm text-muted-foreground">{affiliation}</p>}
        </div>
        <div class="flex flex-col gap-2 sm:items-end">
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            {links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'text-muted-foreground transition-colors hover:text-primary',
                  themeVoice.labels === 'mono-caps'
                    ? 'font-mono text-xs tracking-[0.12em] uppercase'
                    : 'text-sm',
                ]}
              >
                {link.label}
              </a>
            ))}
            {config.footer.rss && config.modules.blog.enabled && (
              <a
                href={`${prefix}/rss.xml`}
                class:list={[
                  'text-muted-foreground transition-colors hover:text-primary',
                  themeVoice.labels === 'mono-caps'
                    ? 'font-mono text-xs tracking-[0.12em] uppercase'
                    : 'text-sm',
                ]}
              >
                {t('layout.rss')}
              </a>
            )}
          </div>
          <p
            class:list={[
              'text-muted-foreground',
              themeVoice.labels === 'mono-caps' ? 'font-mono text-[11px]' : 'text-xs',
            ]}
          >
            {colophon !== null && <>{colophon} · </>}© {year}
          </p>
        </div>
      </div>
    </footer>
  )
}
