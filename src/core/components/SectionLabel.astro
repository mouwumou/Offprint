---
import { themeVoice } from '../theme/current'

interface Props {
  text: string
}

const { text } = Astro.props
---

{
  themeVoice.labels === 'mono-caps' ? (
    <h2 class="mb-6 font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">{text}</h2>
  ) : (
    <h2 class="mb-4 font-serif text-lg font-semibold">{text}</h2>
  )
}
