---
import { useTranslations, type MessageKey } from '../i18n'
import type { Publication } from '../schema'
import { contentHref } from '../content/asset-url'
import { themeVoice } from '../theme/current'

interface Props {
  publication: Publication
  lang: string
  /** plain register: append a trailing cite link to this href. */
  citeHref?: string | undefined
}

const { publication, lang, citeHref } = Astro.props
const t = useTranslations(lang)

const fields: {
  field: 'pdf' | 'code' | 'data' | 'slides' | 'poster' | 'video' | 'website'
  key: MessageKey
}[] = [
  { field: 'pdf', key: 'pub.pdf' },
  { field: 'code', key: 'pub.code' },
  { field: 'data', key: 'pub.data' },
  { field: 'slides', key: 'pub.slides' },
  { field: 'poster', key: 'pub.poster' },
  { field: 'video', key: 'pub.video' },
  { field: 'website', key: 'pub.website' },
]

const mono = themeVoice.labels === 'mono-caps'
const links: { label: string; href: string }[] = []
for (const { field, key } of fields) {
  const href = publication[field]
  if (href) links.push({ label: t(key), href: contentHref(href) })
}
if (publication.arxiv)
  links.push({ label: 'arXiv', href: `https://arxiv.org/abs/${publication.arxiv}` })
if (publication.doi) links.push({ label: 'DOI', href: `https://doi.org/${publication.doi}` })
if (!mono && citeHref) links.push({ label: t('pub.cite'), href: citeHref })
---

{
  links.length > 0 &&
    (mono ? (
      <div class="mt-2 flex flex-wrap gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            class="font-mono text-xs text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
          >
            {link.label}
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-2 flex flex-wrap gap-1.5">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-sm border border-border px-1.5 py-px text-xs leading-5 text-muted-foreground transition-colors hover:border-primary hover:text-primary"
          >
            {link.label}
          </a>
        ))}
      </div>
    ))
}
