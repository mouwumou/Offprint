---
import Footer from './Footer.astro'
import Header from './Header.astro'
import config from '../config/current'
import { langPrefix } from '../config/nav'
import { useTranslations } from '../i18n'
import type { Alternate } from '../seo/alternates'
import Head from '../seo/Head.astro'
import { resolveTheme } from '../theme/resolve'
import '../theme/base.css'

interface Props {
  lang: string
  title: string
  description?: string | undefined
  type?: 'website' | 'article'
  image?: string | undefined
  publishedTime?: Date | undefined
  modifiedTime?: Date | undefined
  alternates?: Alternate[]
  jsonLd?: object | object[]
  canonical?: string | undefined
  noindex?: boolean
}

const {
  lang,
  title,
  description,
  type,
  image,
  publishedTime,
  modifiedTime,
  alternates,
  jsonLd,
  canonical,
  noindex,
} = Astro.props
const t = useTranslations(lang)
const prefix = langPrefix(config, lang)

// Tokens come from the resolved theme's manifest, overlaid with the
// user's theme.tokens (both color schemes) and the accent shorthand.
const { manifest } = resolveTheme(config.theme.name)
const accent = config.theme.accent
const overrides = {
  ...(config.theme.tokens ?? {}),
  ...(accent ? { primary: accent, accent, ring: accent } : {}),
}
const tokenBlock = (table: Record<string, string>): string =>
  Object.entries({ ...table, ...overrides })
    .map(([name, value]) => `--${name}:${value};`)
    .join('')
const proseSize = config.theme.typography?.proseSize ?? manifest.typography.proseSize
const fontBlock = `--font-sans-stack:${manifest.fonts.sans};--font-serif-stack:${manifest.fonts.serif};--font-mono-stack:${manifest.fonts.mono};--prose-size:${proseSize};`
const themeCss = `:root{${tokenBlock(manifest.tokens.light)}${fontBlock}}.dark{${tokenBlock(manifest.tokens.dark)}}`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Head
      lang={lang}
      title={title}
      description={description}
      type={type}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      canonical={canonical}
      noindex={noindex}
      alternates={alternates ?? []}
      jsonLd={jsonLd}
    />
    {
      config.modules.blog.enabled && (
        <>
          <link
            rel="alternate"
            type="application/rss+xml"
            href={`${prefix}/rss.xml`}
            title={`${t('nav.writing')} RSS`}
          />
          <link
            rel="alternate"
            type="application/atom+xml"
            href={`${prefix}/atom.xml`}
            title={`${t('nav.writing')} Atom`}
          />
          <link
            rel="alternate"
            type="application/feed+json"
            href={`${prefix}/feed.json`}
            title={`${t('nav.writing')} JSON Feed`}
          />
        </>
      )
    }
    <script is:inline>
      // Anti-flash: apply the stored/system theme before first paint.
      ;(() => {
        try {
          const stored = localStorage.getItem('theme')
          const dark =
            stored === 'dark' ||
            (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.classList.toggle('dark', dark)
        } catch {
          /* storage unavailable */
        }
      })()
    </script>
    <style set:html={themeCss}></style>
    <slot name="head" />
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <a
        href="#main-content"
        class="sr-only rounded-md bg-primary px-4 py-2 font-mono text-xs tracking-[0.12em] text-primary-foreground uppercase focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
      >
        {t('layout.skipToContent')}
      </a>
      <Header lang={lang} alternates={alternates ?? []} />
      <main id="main-content" tabindex="-1" class="flex-1 outline-none">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
