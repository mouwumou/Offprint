---
import { getProvider } from '../content'
import { markAuthors } from '../content/authors'

interface Props {
  authors: readonly string[]
}

const { authors } = Astro.props
const marked = markAuthors(authors, (await getProvider().getProfile()).nameVariants)
---

<p class="mt-1 text-sm text-muted-foreground">
  {
    marked.map((author, index) => (
      <>
        {author.self ? (
          <strong class="font-semibold text-foreground">{author.name}</strong>
        ) : (
          author.name
        )}
        {index < marked.length - 1 && ', '}
      </>
    ))
  }
</p>
