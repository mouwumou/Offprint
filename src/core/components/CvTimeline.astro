---
export interface TimelineRow {
  period: string
  title: string
  org: string
  location?: string | undefined
  detail?: string | undefined
  highlights?: string[] | undefined
}

interface Props {
  entries: TimelineRow[]
}

const { entries } = Astro.props
---

<div class="space-y-6">
  {
    entries.map((entry) => (
      <div class="grid gap-1 sm:grid-cols-[140px_1fr] sm:gap-6">
        <span class="pt-0.5 font-mono text-xs text-muted-foreground">{entry.period}</span>
        <div>
          <h3 class="font-serif text-lg leading-snug">{entry.title}</h3>
          <p class="text-muted-foreground">
            {entry.org}
            {entry.location && <span class="text-muted-foreground"> · {entry.location}</span>}
          </p>
          {entry.detail && (
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{entry.detail}</p>
          )}
          {(entry.highlights?.length ?? 0) > 0 && (
            <ul class="mt-2 list-disc space-y-1 pl-4 text-sm leading-relaxed text-muted-foreground marker:text-border">
              {entry.highlights?.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))
  }
</div>
