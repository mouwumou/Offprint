---
import config from '../config/current'
import { langPrefix, resolveNav, type NavItem } from '../config/nav'
import { getProvider } from '../content'
import { pagesForLanguage } from '../content/posts-view'
import { selfLabel, useTranslations } from '../i18n'
import { resolveLocalized } from '../schema'
import type { Alternate } from '../seo/alternates'
import ThemeToggle from './ThemeToggle'

interface Props {
  lang: string
  /** Current page's language alternates — the switcher targets these. */
  alternates?: Alternate[]
}

const { lang, alternates = [] } = Astro.props

// Language switcher targets: the current page's translation when it exists,
// otherwise that language's home (ADR-007 interlinking).
const switcher = config.i18n.locales.map((locale) => ({
  locale,
  label: selfLabel(locale),
  current: locale === lang,
  href:
    alternates.find((alternate) => alternate.lang === locale)?.path ??
    (langPrefix(config, locale) || '/'),
}))
const t = useTranslations(lang)
const prefix = langPrefix(config, lang)
// P1-7c/ADR-015: standalone pages participate in nav resolution — as the
// appended nav:true set by default, or as {page} slots in an explicit config.nav.
const navPages = config.modules.pages.enabled
  ? pagesForLanguage(await getProvider().listPages(), lang)
  : []
const nav = resolveNav(config, lang, navPages)
// Brand block (ADR-015): configurable, defaulting to the profile.
const name = resolveLocalized(config.profile.name, lang, config.i18n.default)
const field = resolveLocalized(config.profile.field, lang, config.i18n.default)
const fieldShort = field?.split(/\s*[&＆]\s*/)[0]
const brandTitle =
  config.header.title === false
    ? null
    : (resolveLocalized(config.header.title, lang, config.i18n.default) ?? name)
const brandSubtitle =
  config.header.subtitle === false
    ? null
    : (resolveLocalized(config.header.subtitle, lang, config.i18n.default) ?? fieldShort)

const current = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isActive = (item: NavItem): boolean =>
  item.exact ? current === (prefix || '/') : current.startsWith(item.href)
---

<header
  class="site-header sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8 lg:px-12"
  >
    {
      brandTitle !== null ? (
        <a href={prefix || '/'} class="group flex items-baseline gap-2.5">
          <span class="font-serif text-lg font-semibold tracking-tight">{brandTitle}</span>
          {brandSubtitle && (
            <span class="hidden font-mono text-[10px] tracking-[0.18em] text-muted-foreground uppercase sm:inline">
              {brandSubtitle}
            </span>
          )}
        </a>
      ) : (
        <span />
      )
    }
    <nav class="flex items-center gap-1 sm:gap-2">
      <!-- Inline links need ~700px with every module on, so they live behind
           lg; below that the disclosure drawer at the end takes over (zero JS,
           constraint 6 — details/summary, no island). -->
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
            class:list={[
              'hidden rounded-md px-2.5 py-1.5 font-mono text-xs tracking-[0.12em] uppercase transition-colors lg:inline-block lg:px-3',
              isActive(item) ? 'text-primary' : 'text-muted-foreground hover:text-foreground',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {
        config.header.search && config.modules.blog.enabled && (
          <a
            href={`${prefix}/search`}
            aria-label={t('search.title')}
            class="grid size-9 place-items-center rounded-md border border-border font-mono text-xs text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
          >
            ⌕
          </a>
        )
      }
      {
        config.header.languageSwitcher && config.i18n.locales.length > 1 && (
          <span
            class="ml-1 hidden items-center gap-1 font-mono text-xs sm:ml-2 lg:flex"
            aria-label={t('layout.switchLanguage')}
          >
            {switcher.map((entry, index) => (
              <>
                {index > 0 && <span class="text-border">/</span>}
                {entry.current ? (
                  <span class="px-1 text-primary" aria-current="true">
                    {entry.label}
                  </span>
                ) : (
                  <a
                    href={entry.href}
                    class="px-1 text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {entry.label}
                  </a>
                )}
              </>
            ))}
          </span>
        )
      }
      {
        config.header.themeToggle && (
          <div class="ml-1 sm:ml-2">
            <ThemeToggle client:load label={t('layout.toggleTheme')} />
          </div>
        )
      }
      <details class="relative ml-1 lg:hidden">
        <summary
          aria-label={t('layout.menu')}
          class="grid size-9 cursor-pointer list-none place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground [&::-webkit-details-marker]:hidden"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M2 4h12M2 8h12M2 12h12"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute top-11 right-0 z-50 w-56 rounded-md border border-border bg-background p-2 shadow-lg"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-2 font-mono text-xs tracking-[0.12em] uppercase transition-colors',
                  isActive(item) ? 'text-primary' : 'text-muted-foreground hover:text-foreground',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          {
            config.header.languageSwitcher && config.i18n.locales.length > 1 && (
              <div
                class="mt-1 flex items-center gap-1 border-t border-border px-3 pt-2 pb-1 font-mono text-xs"
                aria-label={t('layout.switchLanguage')}
              >
                {switcher.map((entry, index) => (
                  <>
                    {index > 0 && <span class="text-border">/</span>}
                    {entry.current ? (
                      <span class="px-1 text-primary" aria-current="true">
                        {entry.label}
                      </span>
                    ) : (
                      <a
                        href={entry.href}
                        class="px-1 text-muted-foreground transition-colors hover:text-foreground"
                      >
                        {entry.label}
                      </a>
                    )}
                  </>
                ))}
              </div>
            )
          }
        </div>
      </details>
    </nav>
  </div>
</header>
