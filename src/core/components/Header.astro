---
import config from '../config/current'
import { container } from '../config/layout'
import { homePath, langPrefix, resolveNav, type NavItem } from '../config/nav'
import { getProvider } from '../content'
import { pagesForLanguage } from '../content/posts-view'
import { selfLabel, useTranslations } from '../i18n'
import { resolveLocalized } from '../schema'
import type { Alternate } from '../seo/alternates'
import ThemeToggle from './ThemeToggle'

interface Props {
  lang: string
  /** Current page's language alternates — the switcher targets these. */
  alternates?: Alternate[]
}

const { lang, alternates = [] } = Astro.props

// Language switcher targets: the current page's translation when it exists,
// otherwise that language's home (language interlinking).
const switcher = config.i18n.locales.map((locale) => ({
  locale,
  label: selfLabel(locale),
  current: locale === lang,
  href: alternates.find((alternate) => alternate.lang === locale)?.path ?? homePath(config, locale),
}))
const t = useTranslations(lang)
const prefix = langPrefix(config, lang)
// Standalone pages participate in nav resolution — as the
// appended nav:true set by default, or as {page} slots in an explicit config.nav.
const navPages = config.modules.pages.enabled
  ? pagesForLanguage(await getProvider().listPages(), lang)
  : []
const nav = resolveNav(config, lang, navPages)
// Brand block: configurable, defaulting to the profile (content/profile.yaml).
const profile = await getProvider().getProfile()
const name = resolveLocalized(profile.name, lang, config.i18n.default)
const field = resolveLocalized(profile.field, lang, config.i18n.default)
const fieldShort = field?.split(/\s*[&＆]\s*/)[0]
const brandTitle =
  config.header.title === false
    ? null
    : (resolveLocalized(config.header.title, lang, config.i18n.default) ?? name)
const brandSubtitle =
  config.header.subtitle === false
    ? null
    : (resolveLocalized(config.header.subtitle, lang, config.i18n.default) ?? fieldShort)

const current = Astro.url.pathname.replace(/\/+$/, '') || '/'
const home = homePath(config, lang).replace(/\/+$/, '') || '/'
const isActive = (item: NavItem): boolean =>
  item.exact ? current === home : current.startsWith(item.href)

// Capacity, decided at build time: in the narrow column (~784px usable) the
// brand block (~330px) plus a full inline nav (~570px) plus the icon group
// can never fit at ANY viewport — so with a visible brand, narrow mode sends
// the nav to the disclosure drawer at every size instead of overflowing.
// Without a brand (header.title: false — the academic norm, the name lives
// in the page), the inline nav fits and behaves as before.
const inlineNavFits = !(config.layout.width === 'narrow' && brandTitle !== null)
---

<header
  data-part="site-header"
  class="site-header sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md"
>
  <div class:list={[container, 'flex h-16 items-center justify-between gap-4']}>
    {
      brandTitle !== null ? (
        <a
          href={prefix || '/'}
          data-part="brand"
          class="group flex shrink-0 items-baseline gap-2.5"
        >
          <span class="font-serif text-lg font-semibold tracking-tight whitespace-nowrap">
            {brandTitle}
          </span>
          {brandSubtitle && (
            <span
              class:list={[
                'hidden text-muted-foreground whitespace-nowrap sm:inline',
                'ui-caption',
              ]}
            >
              {brandSubtitle}
            </span>
          )}
        </a>
      ) : (
        <span />
      )
    }
    <nav data-part="nav" class="flex items-center gap-1 sm:gap-2">
      <!-- Inline links need ~700px with every module on, so they live behind
           lg; below that the disclosure drawer at the end takes over (zero JS,
           zero JavaScript by default — details/summary, no island). -->
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-part="nav-item"
            aria-current={isActive(item) ? 'page' : undefined}
            class:list={[
              'hidden rounded-md px-2.5 py-1.5 transition-colors lg:px-3',
              inlineNavFits && 'lg:inline-block',
              'ui-label',
              isActive(item) ? 'text-primary' : 'text-muted-foreground hover:text-foreground',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {
        config.header.search &&
          config.modules.blog.enabled &&
          config.modules.blog.search !== false && (
            <a
              href={`${prefix}/search`}
              aria-label={t('search.title')}
              data-part="nav-search"
              class="grid size-9 place-items-center rounded-md border border-border font-mono text-xs text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
            >
              ⌕
            </a>
          )
      }
      {
        config.header.languageSwitcher && config.i18n.locales.length > 1 && (
          <span
            class:list={[
              'ml-1 hidden items-center gap-1 sm:ml-2',
              inlineNavFits && 'lg:flex',
              'ui-meta',
            ]}
            aria-label={t('layout.switchLanguage')}
            data-part="lang-switch"
          >
            {switcher.map((entry, index) => (
              <>
                {index > 0 && <span class="text-border">/</span>}
                {entry.current ? (
                  <span class="px-1 text-primary" aria-current="true">
                    {entry.label}
                  </span>
                ) : (
                  <a
                    href={entry.href}
                    class="px-1 text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {entry.label}
                  </a>
                )}
              </>
            ))}
          </span>
        )
      }
      {
        config.header.themeToggle && (
          <div data-part="theme-toggle" class="ml-1 sm:ml-2">
            <ThemeToggle client:load label={t('layout.toggleTheme')} />
          </div>
        )
      }
      <details data-part="nav-drawer" class:list={['relative ml-1', inlineNavFits && 'lg:hidden']}>
        <summary
          aria-label={t('layout.menu')}
          class="grid size-9 cursor-pointer list-none place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground [&::-webkit-details-marker]:hidden"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M2 4h12M2 8h12M2 12h12"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute top-11 right-0 z-50 w-56 rounded-md border border-border bg-background p-2 shadow-lg"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-2 transition-colors',
                  'ui-label',
                  isActive(item) ? 'text-primary' : 'text-muted-foreground hover:text-foreground',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          {
            config.header.languageSwitcher && config.i18n.locales.length > 1 && (
              <div
                class:list={[
                  'mt-1 flex items-center gap-1 border-t border-border px-3 pt-2 pb-1',
                  'ui-meta',
                ]}
                aria-label={t('layout.switchLanguage')}
              >
                {switcher.map((entry, index) => (
                  <>
                    {index > 0 && <span class="text-border">/</span>}
                    {entry.current ? (
                      <span class="px-1 text-primary" aria-current="true">
                        {entry.label}
                      </span>
                    ) : (
                      <a
                        href={entry.href}
                        class="px-1 text-muted-foreground transition-colors hover:text-foreground"
                      >
                        {entry.label}
                      </a>
                    )}
                  </>
                ))}
              </div>
            )
          }
        </div>
      </details>
    </nav>
  </div>
</header>
