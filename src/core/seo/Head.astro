---
import config from '../config/current'
import { resolveLocalized } from '../schema'
import type { Alternate } from './alternates'

interface Props {
  lang: string
  title: string
  description?: string | undefined
  /** 'article' adds article OG semantics; default 'website'. */
  type?: 'website' | 'article'
  image?: string | undefined
  publishedTime?: Date | undefined
  modifiedTime?: Date | undefined
  /** hreflang alternates incl. the current page; rendered when >1 language. */
  alternates?: Alternate[]
  /** One or more JSON-LD payloads. */
  jsonLd?: object | object[]
  /** Canonical override (e.g. a syndicated post's original home). */
  canonical?: string | undefined
}

const {
  lang,
  title,
  description,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  alternates = [],
  jsonLd,
  canonical: canonicalOverride,
} = Astro.props

const site = Astro.site ?? new URL('https://example.com')
const siteName = resolveLocalized(config.profile.name, lang, config.i18n.default) ?? 'Offprint'
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, site).toString()
const absoluteImage = image ? new URL(image, site).toString() : undefined
const ogLocale = lang === 'zh' ? 'zh_CN' : lang === 'en' ? 'en_US' : lang
const payloads = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd]
const defaultLangAlternate = alternates.find((a) => a.lang === config.i18n.default)
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />

{
  alternates.length > 1 &&
    alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.lang}
        href={new URL(alternate.path, site).toString()}
      />
    ))
}
{
  alternates.length > 1 && defaultLangAlternate && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(defaultLangAlternate.path, site).toString()}
    />
  )
}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{
  type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )
}

<meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

{
  payloads.map((payload) => (
    <script type="application/ld+json" set:html={JSON.stringify(payload)} />
  ))
}
