---
import config from '../config/current'
import { getProvider } from '../content'
import { resolveLocalized } from '../schema'
import type { Alternate } from './alternates'

interface Props {
  lang: string
  title: string
  description?: string | undefined
  /** 'article' adds article OG semantics; default 'website'. */
  type?: 'website' | 'article'
  image?: string | undefined
  publishedTime?: Date | undefined
  modifiedTime?: Date | undefined
  /** hreflang alternates incl. the current page; rendered when >1 language. */
  alternates?: Alternate[]
  /** One or more JSON-LD payloads. */
  jsonLd?: object | object[]
  /** Canonical override (e.g. a syndicated post's original home). */
  canonical?: string | undefined
  /** Keep the page out of the index (e.g. 404): emits robots noindex and
   * suppresses the canonical link, whose URL would otherwise be the miss. */
  noindex?: boolean
}

const {
  lang,
  title,
  description,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  alternates = [],
  jsonLd,
  canonical: canonicalOverride,
  noindex = false,
} = Astro.props

// JSON.stringify does not escape '<', so a payload string containing
// '</script>' (from a post title/venue etc.) would close the ld+json block
// and inject HTML. Escape the three characters that can break out of, or be
// misparsed inside, an inline script — plus the JS line terminators.
const JSONLD_UNSAFE = /[<>&\u2028\u2029]/g
const jsonLdSafe = (payload: object): string =>
  JSON.stringify(payload).replace(
    JSONLD_UNSAFE,
    (c) => '\\u' + c.charCodeAt(0).toString(16).padStart(4, '0'),
  )

const site = Astro.site ?? new URL('https://example.com')
const profile = await getProvider().getProfile()
const siteName = resolveLocalized(profile.name, lang, config.i18n.default) ?? 'Offprint'
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, site).toString()
const absoluteImage = image ? new URL(image, site).toString() : undefined
const ogLocale = lang === 'zh' ? 'zh_CN' : lang === 'en' ? 'en_US' : lang
const payloads = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd]
// i18n.noindex: those locales are hidden from engines — robots noindex here,
// and never advertised as hreflang alternates of the visible ones.
const hiddenLocales = config.i18n.noindex
const pageNoindex = noindex || hiddenLocales.includes(lang)
const visibleAlternates = alternates.filter((a) => !hiddenLocales.includes(a.lang))
const defaultLangAlternate = visibleAlternates.find((a) => a.lang === config.i18n.default)
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{pageNoindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

{
  visibleAlternates.length > 1 &&
    visibleAlternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.lang}
        href={new URL(alternate.path, site).toString()}
      />
    ))
}
{
  visibleAlternates.length > 1 && defaultLangAlternate && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(defaultLangAlternate.path, site).toString()}
    />
  )
}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{
  type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )
}

<meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

{payloads.map((payload) => <script type="application/ld+json" set:html={jsonLdSafe(payload)} />)}
