---
// A theme-carried widget: replaces the built-in site footer. Same props as
// the built-in (src/core/components/Footer.astro); data comes from the
// provider like everywhere else.
import { getProvider } from '../../../../src/core/content'
import siteConfig from '../../../../src/core/config/current'
import { resolveLocalized } from '../../../../src/core/schema'

interface Props {
  lang: string
}

const { lang } = Astro.props
const profile = await getProvider().getProfile()
const name = resolveLocalized(profile.name, lang, siteConfig.i18n.default)
---

{
  siteConfig.footer.enabled && (
    <footer data-part="site-footer" class="mt-12 border-t border-border">
      <div class="mx-auto flex w-full max-w-[53rem] items-baseline justify-between px-5 py-5 text-sm sm:px-8">
        <span data-part="footer-name">{name}</span>
        <span data-part="footer-colophon" class="text-muted-foreground">
          © {new Date().getFullYear()} · gutter theme
        </span>
      </div>
    </footer>
  )
}
