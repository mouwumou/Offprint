{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offprint site.yaml",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "nameVariants": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "affiliation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "photo": {
          "type": "string"
        },
        "tagline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "bio": {
          "default": [],
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "interests": {
          "default": [],
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "orcid": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
        },
        "scholar": {
          "type": "string"
        },
        "links": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "href": {
                "type": "string",
                "format": "uri"
              },
              "kind": {
                "type": "string"
              }
            },
            "required": ["label", "href"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "modules": {
      "default": {},
      "type": "object",
      "properties": {
        "blog": {
          "default": true,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "colophon": {
                  "anyOf": [
                    {
                      "type": "boolean",
                      "const": false
                    },
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "pages": {
          "default": true,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "publications": {
          "default": true,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "projects": {
          "default": true,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "news": {
          "default": true,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "cv": {
          "default": true,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": {}
    },
    "nav": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "enum": ["home", "blog", "publications", "projects", "cv"]
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "required": ["module"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "page": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "required": ["page"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "href": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "required": ["href", "label"],
            "additionalProperties": false
          }
        ]
      }
    },
    "layout": {
      "default": {},
      "type": "object",
      "properties": {
        "width": {
          "default": "narrow",
          "type": "string",
          "enum": ["narrow", "wide"]
        }
      },
      "additionalProperties": false
    },
    "header": {
      "default": {},
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "boolean",
              "const": false
            },
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          ]
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "boolean",
              "const": false
            },
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          ]
        },
        "search": {
          "default": true,
          "type": "boolean"
        },
        "themeToggle": {
          "default": true,
          "type": "boolean"
        },
        "languageSwitcher": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "footer": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "colophon": {
          "anyOf": [
            {
              "type": "boolean",
              "const": false
            },
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          ]
        },
        "rss": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "default": {},
      "type": "object",
      "properties": {
        "name": {
          "default": "scholar",
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "tokens": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "background",
              "foreground",
              "card",
              "card-foreground",
              "primary",
              "primary-foreground",
              "secondary",
              "secondary-foreground",
              "muted",
              "muted-foreground",
              "accent",
              "accent-foreground",
              "border",
              "ring",
              "radius"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "required": [
            "background",
            "foreground",
            "card",
            "card-foreground",
            "primary",
            "primary-foreground",
            "secondary",
            "secondary-foreground",
            "muted",
            "muted-foreground",
            "accent",
            "accent-foreground",
            "border",
            "ring",
            "radius"
          ]
        }
      },
      "additionalProperties": false
    },
    "i18n": {
      "default": {},
      "type": "object",
      "properties": {
        "default": {
          "default": "en",
          "type": "string",
          "minLength": 2
        },
        "locales": {
          "default": ["en", "zh"],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "static",
          "type": "string",
          "enum": ["static", "server"]
        },
        "store": {
          "default": "fs",
          "type": "string",
          "enum": ["fs", "git"]
        }
      },
      "additionalProperties": false
    },
    "comments": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "giscus",
          "type": "string",
          "const": "giscus"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$"
        },
        "repoId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "redirects": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\/"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\/"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "destination": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\/"
                  },
                  {
                    "type": "string",
                    "format": "uri"
                  }
                ]
              },
              "status": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 300
                  },
                  {
                    "type": "number",
                    "const": 301
                  },
                  {
                    "type": "number",
                    "const": 302
                  },
                  {
                    "type": "number",
                    "const": 303
                  },
                  {
                    "type": "number",
                    "const": 304
                  },
                  {
                    "type": "number",
                    "const": 307
                  },
                  {
                    "type": "number",
                    "const": 308
                  }
                ]
              }
            },
            "required": ["destination", "status"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["profile"],
  "additionalProperties": false
}
