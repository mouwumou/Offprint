# ── Runtime ──────────────────────────────────────────────────────────────────
# static (default, baseline) | server (optional runtime, phase 2) — ADR-003
RUNTIME_MODE=static
# Public site origin, used for canonical URLs / sitemap / feeds
SITE_URL=https://example.com
# Default UI/content language: en | zh (ADR-007; can also be set in site.config.ts)
DEFAULT_LANG=en

# ── Content store (ADR-004) ──────────────────────────────────────────────────
# fs (default) | git | s3
CONTENT_STORE=fs
# Directory holding materialized content (posts/, pages/, *.yaml, manifest.json)
CONTENT_DIR=./content
# git store (phase 2): GitHub repo holding content/, e.g. user/repo#branch
CONTENT_GIT_REPO=
# s3 store (phase 2): S3/R2/MinIO-compatible bucket
CONTENT_S3_ENDPOINT=
CONTENT_S3_BUCKET=
CONTENT_S3_ACCESS_KEY_ID=
CONTENT_S3_SECRET_ACCESS_KEY=

# ── Sync (src/sync: elog → content/) ─────────────────────────────────────────
# Notion integration token (never commit the real one)
NOTION_TOKEN=
# Notion posts database id
NOTION_DB=
# elog image bed platform; `local` writes images into CONTENT_DIR/assets
IMAGE_PLATFORM=local
# Cron expression for the sync container (docker compose); keep it quoted so
# the file stays safe to source from a shell
SYNC_CRON="*/5 * * * *"

# ── Revalidation (server mode, phase 2) ──────────────────────────────────────
# Shared secret for POST /api/revalidate (x-revalidate-secret header)
REVALIDATE_SECRET=
# URL the sync job notifies after an atomic content switch
REVALIDATE_URL=
