# Offprint environment variables — copy to .env and fill in what you use.
#
# Who reads .env:
#   - `pnpm sync` run on your machine (loads .env from the current directory)
#   - Docker Compose, for both compose.static.yaml and compose.server.yaml
#     (Compose reads .env from the directory of the compose file: this one)
# Who does not:
#   - `pnpm dev` / `pnpm build:*` — they take SITE_URL from the shell
#   - GitHub Actions — an instance repository uses Settings → Secrets and
#     Variables instead (SYNC_ENABLED, NOTION_TOKEN, NOTION_DB, SITE_URL)
# Never commit a filled-in .env: .gitignore and .dockerignore exclude .env*.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL of the site, absolute. A path component
# (https://user.github.io/repo) makes it a sub-path deployment: every
# internal link, feed, and the search index carry that prefix.
SITE_URL=https://example.com
# Language assumed for posts whose language cannot be detected: en | zh
DEFAULT_LANG=en

# ── Notion sync — `pnpm sync` and the Docker sync container ─────────────────
# Notion integration token (secret_… / ntn_…) and the posts database id
NOTION_TOKEN=
NOTION_DB=
# local (default): download Notion-hosted images into content/assets and
# rewrite the links — their signed URLs expire within hours. Any other value
# leaves the URLs untouched.
IMAGE_PLATFORM=local
# true: also import Notion documents of type "Page" into content/pages.
# Off by default: pages/ is yours to write and sync never touches it unless asked.
SYNC_PAGES=false
# Seconds between sync passes in the Docker sync container
SYNC_INTERVAL=300

# ── Docker, static self-hosting (compose.static.yaml) ────────────────────────
# Host port Caddy listens on
WEB_PORT=8080
# Built releases kept on the site volume (the current one plus rollbacks)
KEEP_RELEASES=2

# ── Docker, server mode (compose.server.yaml) ────────────────────────────────
# Host port of the site process
SITE_PORT=4321
# Shared secret for POST /api/revalidate and POST /api/sync
# (x-revalidate-secret header). Required in server mode — use a long random
# string, e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=
# Optional: verify Notion webhook signatures on POST /api/sync
NOTION_WEBHOOK_SECRET=

# ── Advanced: where the server reads content from ────────────────────────────
# fs (default): the directory in CONTENT_DIR. git: a GitHub repository read
# at request time (for deployments without a persistent volume).
CONTENT_STORE=fs
CONTENT_DIR=./content
# git store: repository holding content/, e.g. owner/repo#branch
CONTENT_GIT_REPO=
# git store: directory inside that repository (default content)
CONTENT_GIT_DIR=content
# git store: token for private repositories / higher rate limits
GITHUB_TOKEN=
# URL the sync job notifies after a content change; compose sets it for you,
# only a custom layout needs it
REVALIDATE_URL=
