# Where these values live (ADR-017): local development and self-hosted
# servers use a .env file (gitignored, never committed); GitHub Actions on an
# INSTANCE repo uses Settings → Secrets/Variables. The public template repo
# itself carries no secrets anywhere.

# ── Runtime ──────────────────────────────────────────────────────────────────
# static (default, baseline) | server (optional runtime, phase 2) — ADR-003
RUNTIME_MODE=static
# Public site URL (absolute), used for canonical URLs / sitemap / feeds. A path
# component (https://user.github.io/repo) makes it a sub-path deployment: the
# build derives Astro `base` from it and prefixes every internal link (ADR-023)
SITE_URL=https://example.com
# Default UI/content language: en | zh (ADR-007; can also be set in site.yaml)
DEFAULT_LANG=en

# ── Content store (ADR-004) ──────────────────────────────────────────────────
# fs (default) | git | s3
CONTENT_STORE=fs
# Directory holding materialized content (posts/, pages/, *.yaml, manifest.json)
CONTENT_DIR=./content
# git store (phase 2): GitHub repo holding content/, e.g. user/repo#branch
CONTENT_GIT_REPO=
# git store: subdirectory holding content/ inside that repo (default content)
CONTENT_GIT_DIR=content
# git store: token for private repos / rate limits
GITHUB_TOKEN=
# s3 store (phase 2): S3/R2/MinIO-compatible bucket
CONTENT_S3_ENDPOINT=
CONTENT_S3_BUCKET=
CONTENT_S3_ACCESS_KEY_ID=
CONTENT_S3_SECRET_ACCESS_KEY=

# ── Sync (src/sync: elog → content/) ─────────────────────────────────────────
# Notion integration token (never commit the real one)
NOTION_TOKEN=
# Notion posts database id
NOTION_DB=
# `local` (default): sync downloads Notion-hosted images into
# CONTENT_DIR/assets and rewrites links (their signed URLs expire within
# hours). Any other value keeps the original URLs untouched.
IMAGE_PLATFORM=local
# Opt-in: also route Notion type=Page docs into content/pages (ADR-014;
# by default pages/ is author-owned and sync never writes it)
SYNC_PAGES=false
# Cron expression for the sync container (docker compose); keep it quoted so
# the file stays safe to source from a shell
SYNC_CRON="*/5 * * * *"

# ── Revalidation (server mode, phase 2) ──────────────────────────────────────
# Shared secret for POST /api/revalidate (x-revalidate-secret header)
REVALIDATE_SECRET=
# URL the sync job notifies after an atomic content switch
REVALIDATE_URL=
# Optional: verify Notion webhook signatures on POST /api/sync (P2-7)
NOTION_WEBHOOK_SECRET=
