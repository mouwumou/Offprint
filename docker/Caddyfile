# Serves the static build (dist/). TLS/domain config belongs to the host's
# reverse proxy or an extended Caddyfile in deployment (compose).
:80 {
	root * /srv
	encode zstd gzip

	# Astro emits content-hashed assets under /_astro — cache them forever.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	file_server
}
